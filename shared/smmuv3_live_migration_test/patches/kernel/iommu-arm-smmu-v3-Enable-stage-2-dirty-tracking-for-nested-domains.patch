From 1736f0dff4728818bb0b578a9d4b8d91037fccbb Mon Sep 17 00:00:00 2001
From: Shameer Kolothum <skolothumtho@nvidia.com>
Date: Tue, 1 Sep 2026 13:47:52 +0000
Subject: [PATCH] iommu/arm-smmu-v3: Enable stage-2 dirty tracking for nested
 domains

HTTU can track access and dirty state for both stage-1 and stage-2, but
only stage-1 domains make use of it today. In a nested setup the guest
owns stage-1 and the host owns stage-2, so the host needs HTTU enabled on
the stage-2 domain to track dirty pages.

So set PT_FEAT_ARMV8_DBM for stage-2 when dirty tracking is requested,
set S2HA/S2HD in the STE to match, and allow
IOMMU_HWPT_ALLOC_DIRTY_TRACKING along with IOMMU_HWPT_ALLOC_NEST_PARENT
if the SMMU is DBM capable.

Note: Not tested

Signed-off-by: Shameer Kolothum <skolothumtho@nvidia.com>
---
 drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c | 18 ++++++++++++++++--
 drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h |  2 ++
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
index f57e6f896ececd..20832640ed9217 100644
--- a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
+++ b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
@@ -1996,6 +1996,12 @@ void arm_smmu_make_s2_domain_ste(struct arm_smmu_ste *target,
 		(master->stall_enabled ? STRTAB_STE_2_S2S : 0) |
 		STRTAB_STE_2_S2R);
 
+	/* S2HD requires S2HA, the PTEs carry the DBM bit for both */
+	if (smmu_domain->armv8pt.armpt.common.features &
+	    BIT(PT_FEAT_ARMV8_DBM))
+		target->data[2] |= cpu_to_le64(STRTAB_STE_2_S2HA |
+					       STRTAB_STE_2_S2HD);
+
 	target->data[3] = cpu_to_le64(info.ttb & STRTAB_STE_3_S2TTB_MASK);
 }
 EXPORT_SYMBOL_IF_KUNIT(arm_smmu_make_s2_domain_ste);
@@ -3216,14 +3222,16 @@ static int arm_smmu_domain_finalise(struct arm_smmu_domain *smmu_domain,
 		finalise_stage_fn = arm_smmu_domain_finalise_s1;
 		break;
 	case ARM_SMMU_DOMAIN_S2:
-		if (enable_dirty)
-			return -EOPNOTSUPP;
 		cfg.common.features |= BIT(PT_FEAT_ARMV8_S2);
 		cfg.common.hw_max_vasz_lg2 = smmu->oas;
 		cfg.common.hw_max_oasz_lg2 = smmu->oas;
 		if ((smmu->features & ARM_SMMU_FEAT_S2FWB) &&
 		    (flags & IOMMU_HWPT_ALLOC_NEST_PARENT))
 			cfg.common.features |= BIT(PT_FEAT_ARMV8_S2FWB);
+		if (enable_dirty) {
+			cfg.common.features |= BIT(PT_FEAT_ARMV8_DBM);
+			smmu_domain->domain.dirty_ops = &arm_smmu_dirty_ops;
+		}
 		finalise_stage_fn = arm_smmu_domain_finalise_s2;
 		break;
 	default:
@@ -4247,10 +4255,16 @@ arm_smmu_domain_alloc_paging_flags(struct device *dev, u32 flags,
 			smmu_domain->stage = ARM_SMMU_DOMAIN_S2;
 		break;
 	case IOMMU_HWPT_ALLOC_NEST_PARENT:
+	case IOMMU_HWPT_ALLOC_NEST_PARENT | IOMMU_HWPT_ALLOC_DIRTY_TRACKING:
 		if (!(smmu->features & ARM_SMMU_FEAT_NESTING)) {
 			ret = -EOPNOTSUPP;
 			goto err_free;
 		}
+		if ((flags & IOMMU_HWPT_ALLOC_DIRTY_TRACKING) &&
+		    !arm_smmu_dbm_capable(smmu)) {
+			ret = -EOPNOTSUPP;
+			goto err_free;
+		}
 		smmu_domain->stage = ARM_SMMU_DOMAIN_S2;
 		smmu_domain->nest_parent = true;
 		break;
diff --git a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h
index 3e8519936c9479..6136082d1fcd10 100644
--- a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h
+++ b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.h
@@ -298,6 +298,8 @@ static inline u32 arm_smmu_strtab_l2_idx(u32 sid)
 #define STRTAB_STE_2_S2AA64		(1UL << 51)
 #define STRTAB_STE_2_S2ENDI		(1UL << 52)
 #define STRTAB_STE_2_S2PTW		(1UL << 54)
+#define STRTAB_STE_2_S2HD		(1UL << 55)
+#define STRTAB_STE_2_S2HA		(1UL << 56)
 #define STRTAB_STE_2_S2S		(1UL << 57)
 #define STRTAB_STE_2_S2R		(1UL << 58)
 
