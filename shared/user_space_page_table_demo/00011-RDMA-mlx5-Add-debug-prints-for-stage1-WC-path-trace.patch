From f5a350d5c56c1cf51c71432727f44bc2391d6497 Mon Sep 17 00:00:00 2001
From: AkiraZheng <1428384878@qq.com>
Date: Wed, 15 Apr 2026 12:38:33 +0000
Subject: [PATCH] RDMA/mlx5: Add debug prints for stage1 WC path tracing

This patch adds debug prints in mlx5_ib_test_wc() and set_ucontext_resp()
to trace the stage1 page table attribute configuration path for UAR
( User Access Region ) doorbell registers.

Debug prints added:
- mlx5_ib_test_wc(): prints bf capability, roce_en, port_type,
  mlx5_core_is_pf() result and final wc_support value
- set_ucontext_resp(): prints bf_reg_size setting and wc_support status

Usage:
  After applying this patch and rebuilding the kernel/module, run the
  test workload (e.g., ib_read_lat) and check dmesg for prints like:

    mlx5_ib_test_wc: START - bf=1, roce_en=1, port_type=1
    mlx5_ib_test_wc: non-RoCE ETH path - mlx5_core_is_pf=0, setting wc_support=0
    mlx5_ib_test_wc: FINAL - dev->wc_support=0
    set_ucontext_resp: dev->wc_support=0, bf_reg_size=0 (WC NOT supported)

  This helps diagnose why Guest VM with VFIO+mlx5 VF uses DEVICE_nGnRnE
  attribute instead of NORMAL-NC, causing higher doorbell latency.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 drivers/infiniband/hw/mlx5/main.c | 11 ++++++++++-
 drivers/infiniband/hw/mlx5/mem.c  | 13 ++++++++++++-
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/drivers/infiniband/hw/mlx5/main.c b/drivers/infiniband/hw/mlx5/main.c
index 9af948f9a2be..8e1de9737967 100644
--- a/drivers/infiniband/hw/mlx5/main.c
+++ b/drivers/infiniband/hw/mlx5/main.c
@@ -1822,9 +1822,18 @@ static int set_ucontext_resp(struct ib_ucontext *uctx,
 	}
 
 	resp->qp_tab_size = 1 << MLX5_CAP_GEN(dev->mdev, log_max_qp);
-	if (dev->wc_support)
+	if (dev->wc_support) {
 		resp->bf_reg_size = 1 << MLX5_CAP_GEN(dev->mdev,
 						      log_bf_reg_size);
+		pr_info("set_ucontext_resp: dev->wc_support=%d, bf_reg_size=%llu (log_bf_reg_size=%d)\n",
+		       dev->wc_support,
+		       (unsigned long long)resp->bf_reg_size,
+		       MLX5_CAP_GEN(dev->mdev, log_bf_reg_size));
+	} else {
+		resp->bf_reg_size = 0;
+		pr_info("set_ucontext_resp: dev->wc_support=%d, bf_reg_size=0 (WC NOT supported)\n",
+		       dev->wc_support);
+	}
 	resp->cache_line_size = cache_line_size();
 	resp->max_sq_desc_sz = MLX5_CAP_GEN(dev->mdev, max_wqe_sz_sq);
 	resp->max_rq_desc_sz = MLX5_CAP_GEN(dev->mdev, max_wqe_sz_rq);
diff --git a/drivers/infiniband/hw/mlx5/mem.c b/drivers/infiniband/hw/mlx5/mem.c
index 5a22be14d958..2af9c5f7908b 100644
--- a/drivers/infiniband/hw/mlx5/mem.c
+++ b/drivers/infiniband/hw/mlx5/mem.c
@@ -214,9 +214,17 @@ int mlx5_ib_test_wc(struct mlx5_ib_dev *dev)
 	if (!MLX5_CAP_GEN(dev->mdev, bf))
 		return 0;
 
+	/* DEBUG: Print stage1 WC path determination */
+	pr_info("mlx5_ib_test_wc: START - bf=%d, roce_en=%d, port_type=%d\n",
+	       MLX5_CAP_GEN(dev->mdev, bf),
+	       dev->mdev->roce.roce_en, port_type_cap);
+
 	if (!dev->mdev->roce.roce_en &&
 	    port_type_cap == MLX5_CAP_PORT_TYPE_ETH) {
-		if (mlx5_core_is_pf(dev->mdev))
+		int is_pf = mlx5_core_is_pf(dev->mdev);
+		pr_info("mlx5_ib_test_wc: non-RoCE ETH path - mlx5_core_is_pf=%d, setting wc_support=%d\n",
+		       is_pf, arch_can_pci_mmap_wc());
+		if (is_pf)
 			dev->wc_support = arch_can_pci_mmap_wc();
 		return 0;
 	}
@@ -275,6 +283,9 @@ int mlx5_ib_test_wc(struct mlx5_ib_dev *dev)
 		ret = 0;
 	}
 
+	/* DEBUG: Final wc_support result */
+	pr_info("mlx5_ib_test_wc: FINAL - dev->wc_support=%d\n", dev->wc_support);
+
 out4:
 	ib_destroy_qp(qp);
 out3:
-- 
