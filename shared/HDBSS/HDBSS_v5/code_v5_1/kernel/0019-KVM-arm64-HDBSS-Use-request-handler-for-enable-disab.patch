From 063a0a70fdc17bf71ea12f29bc8d856cd63da148 Mon Sep 17 00:00:00 2001
From: AkiraZheng <1428384878@qq.com>
Date: Thu, 27 Aug 2026 23:11:09 +0800
Subject: [PATCH 19/19] KVM: arm64: HDBSS: Use request-handler for
 enable/disable and kick for sync
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Align HDBSS enable/disable with x86 PML's request-handler pattern, and
use plain kvm_vcpu_kick() for sync_dirty_log (also matching x86).

Enable/disable (KVM_REQ_HDBSS_RELOAD):
  Rename the unused KVM_REQ_FLUSH_HDBSS to KVM_REQ_HDBSS_RELOAD.
  kvm_arm_enable/disable_hdbss_global() now sends KVM_REQ_HDBSS_RELOAD
  instead of KVM_REQ_OUTSIDE_GUEST_MODE.  The request is processed in
  check_vcpu_requests() before the next guest entry, where the handler
  reloads VTCR_EL2 via __load_stage2() and HDBSS registers.

  This closes the stale-hardware window: previously, modifying the
  software VTCR and kicking vCPUs did not reload vtcr_el2 within the
  same KVM_RUN (only at the next vcpu_load).  Now the request handler
  reloads VTCR before re-entering guest, ensuring hardware matches
  software at a well-defined point — same as x86's VMCS update via
  KVM_REQ_UPDATE_CPU_DIRTY_LOGGING.

sync_dirty_log (kvm_vcpu_kick):
  kvm_arch_sync_dirty_log() now uses kvm_for_each_vcpu + kvm_vcpu_kick,
  matching x86's kvm_arch_sync_dirty_log().  The flush happens on every
  VM exit; the kick is sufficient because the dirty-log protocol (GET/
  CLEAR) tolerates concurrent bitmap writes — bits set after the snapshot
  survive the clear and are reported in the next iteration.

Base commit: 0e35b9b6ec0f

Signed-off-by: AkiraZheng <1428384878@qq.com>
---
 arch/arm64/include/asm/kvm_host.h |  2 +-
 arch/arm64/kvm/arm.c              | 35 ++++++++++++++++++++++++++-----
 arch/arm64/kvm/dirty_bit.c        | 21 ++++++++++++-------
 3 files changed, 44 insertions(+), 14 deletions(-)

diff --git a/arch/arm64/include/asm/kvm_host.h b/arch/arm64/include/asm/kvm_host.h
index 02035fd913af..df5a74ff5bbc 100644
--- a/arch/arm64/include/asm/kvm_host.h
+++ b/arch/arm64/include/asm/kvm_host.h
@@ -55,7 +55,7 @@
 #define KVM_REQ_GUEST_HYP_IRQ_PENDING	KVM_ARCH_REQ(9)
 #define KVM_REQ_MAP_L1_VNCR_EL2		KVM_ARCH_REQ(10)
 #define KVM_REQ_VGIC_PROCESS_UPDATE	KVM_ARCH_REQ(11)
-#define KVM_REQ_FLUSH_HDBSS		KVM_ARCH_REQ(12)
+#define KVM_REQ_HDBSS_RELOAD		KVM_ARCH_REQ(12)
 
 #define KVM_DIRTY_LOG_MANUAL_CAPS   (KVM_DIRTY_LOG_MANUAL_PROTECT_ENABLE | \
 				     KVM_DIRTY_LOG_INITIALLY_SET)
diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index 44755954727c..d26d389a06f0 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -1260,6 +1260,25 @@ static int check_vcpu_requests(struct kvm_vcpu *vcpu)
 		if (kvm_check_request(KVM_REQ_SUSPEND, vcpu))
 			return kvm_vcpu_suspend(vcpu);
 
+		if (kvm_check_request(KVM_REQ_HDBSS_RELOAD, vcpu)) {
+			/*
+			 * Reload VTCR_EL2 and HDBSS registers from the
+			 * (possibly modified) software state before the
+			 * next guest entry.  This runs after the exit-path
+			 * flush, ensuring hardware matches software and
+			 * closing the stale-hardware window that would
+			 * otherwise exist until the next vcpu_load.
+			 */
+			__load_stage2(vcpu->arch.hw_mmu);
+			if (vcpu_hdbss_enabled(vcpu)) {
+				write_sysreg_s(vcpu->arch.hdbss.hdbssbr_el2,
+					       SYS_HDBSSBR_EL2);
+				write_sysreg_s(vcpu->arch.hdbss.hdbssprod_el2,
+					       SYS_HDBSSPROD_EL2);
+				isb();
+			}
+		}
+
 		if (kvm_dirty_ring_check_request(vcpu))
 			return 0;
 
@@ -2089,16 +2108,22 @@ long kvm_arch_vcpu_unlocked_ioctl(struct file *filp, unsigned int ioctl,
 
 void kvm_arch_sync_dirty_log(struct kvm *kvm, struct kvm_memory_slot *memslot)
 {
+	struct kvm_vcpu *vcpu;
+	unsigned long i;
+
 	/*
-	 * Kick all vCPUs out of guest mode.  The HDBSS buffer is flushed
-	 * in the VM exit path (before handle_exit_early), so ensuring
-	 * vCPUs are in root mode guarantees all buffered dirty entries
-	 * have been pushed to the dirty bitmap or dirty ring.
+	 * Kick running vCPUs out of guest mode.  The HDBSS buffer is
+	 * flushed on every VM exit (before handle_exit_early), so only
+	 * vCPUs currently in guest mode can hold unflushed entries.  The
+	 * dirty-log protocol (GET_DIRTY_LOG / CLEAR_DIRTY_LOG) tolerates
+	 * concurrent bitmap writes: bits set after the snapshot survive
+	 * the clear and are reported in the next iteration.
 	 */
 	if (!kvm_hdbss_enabled(kvm))
 		return;
 
-	kvm_make_all_cpus_request(kvm, KVM_REQ_OUTSIDE_GUEST_MODE);
+	kvm_for_each_vcpu(i, vcpu, kvm)
+		kvm_vcpu_kick(vcpu);
 }
 
 static int kvm_vm_ioctl_set_device_addr(struct kvm *kvm,
diff --git a/arch/arm64/kvm/dirty_bit.c b/arch/arm64/kvm/dirty_bit.c
index 59ed944dd7e5..393c9d279fb9 100644
--- a/arch/arm64/kvm/dirty_bit.c
+++ b/arch/arm64/kvm/dirty_bit.c
@@ -140,8 +140,8 @@ int kvm_handle_hdbss_fault(struct kvm_vcpu *vcpu)
  * by kvm_arch_commit_memory_region() under kvm->slots_lock.
  *
  * HDBSS buffers are pre-allocated at vCPU create time (PML-style), so
- * this function only sets VTCR bits and kicks all vCPUs out of guest
- * mode to reload the new VTCR value on next entry. No buffer allocation
+ * this function only sets VTCR bits and sends a request to all vCPUs
+ * to reload VTCR_EL2 before next guest entry. No buffer allocation
  * or deallocation happens here.
  */
 static void kvm_arm_enable_hdbss_global(struct kvm *kvm)
@@ -161,10 +161,13 @@ static void kvm_arm_enable_hdbss_global(struct kvm *kvm)
 		 sizeof(u64));
 
 	/*
-	 * We should kick vcpus out of guest mode here to load new
-	 * vtcr value to vtcr_el2 register when re-enter guest mode.
+	 * Send a request to all vCPUs to reload VTCR_EL2 and HDBSS
+	 * registers from the updated software state before next guest
+	 * entry.  This ensures hardware matches software, preventing a
+	 * stale-hardware window where the guest runs with outdated HDBSS
+	 * configuration.
 	 */
-	kvm_make_all_cpus_request(kvm, KVM_REQ_OUTSIDE_GUEST_MODE);
+	kvm_make_all_cpus_request(kvm, KVM_REQ_HDBSS_RELOAD);
 }
 
 void kvm_arm_disable_hdbss_global(struct kvm *kvm)
@@ -178,11 +181,13 @@ void kvm_arm_disable_hdbss_global(struct kvm *kvm)
 	kvm_info("HDBSS disabled\n");
 
 	/*
-	 * We should kick vcpus out of guest mode here to load new
-	 * vtcr value to vtcr_el2 register when re-enter guest mode.
+	 * Send a request to all vCPUs to reload VTCR_EL2 before next
+	 * guest entry.  This closes the stale-hardware window: the
+	 * handler reloads VTCR (turning off HDBSS in hardware) before
+	 * the guest can write more pages and fill the buffer.
 	 * Buffers are freed at vCPU destroy time, not here.
 	 */
-	kvm_make_all_cpus_request(kvm, KVM_REQ_OUTSIDE_GUEST_MODE);
+	kvm_make_all_cpus_request(kvm, KVM_REQ_HDBSS_RELOAD);
 }
 
 void kvm_arm_hdbss_on_dirty_logging_change(struct kvm *kvm, int nr_memslots_logging)
-- 
