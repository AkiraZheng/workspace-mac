From ebd12253026ba2ac6620b09b29a479191b55a705 Mon Sep 17 00:00:00 2001
From: AkiraZheng <1428384878@qq.com>
Date: Sat, 15 Aug 2026 03:44:09 +0800
Subject: [PATCH 06/19] KVM: arm64: HDBSS v5 Phase 1: Trivial fixes

Fix several minor issues identified during community review:

1. Fix parameter name typo in has_vhe_hdbss(): 'cope' -> 'scope'
2. Add '!!' to esr_iss2_is_hdbssf() return value for proper bool conversion
3. Fix copyright notices in kvm_dirty_bit.h and dirty_bit.c to reflect
   the actual file authors instead of ARM Ltd.

These are single-line changes with no functional impact.

Based on community_conversion.md Phase 1 tasks.
Base commit: 0e35b9b6ec0f
---
 arch/arm64/include/asm/esr.h           | 2 +-
 arch/arm64/include/asm/kvm_dirty_bit.h | 4 ++--
 arch/arm64/kernel/cpufeature.c         | 4 ++--
 arch/arm64/kvm/dirty_bit.c             | 4 ++--
 4 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/include/asm/esr.h b/arch/arm64/include/asm/esr.h
index fda46007e27d..4b3ccd407faa 100644
--- a/arch/arm64/include/asm/esr.h
+++ b/arch/arm64/include/asm/esr.h
@@ -439,7 +439,7 @@
 
 static inline bool esr_iss2_is_hdbssf(unsigned long esr)
 {
-	return ESR_ELx_ISS2(esr) & ESR_ELx_HDBSSF;
+	return !!(ESR_ELx_ISS2(esr) & ESR_ELx_HDBSSF);
 }
 
 static inline unsigned long esr_brk_comment(unsigned long esr)
diff --git a/arch/arm64/include/asm/kvm_dirty_bit.h b/arch/arm64/include/asm/kvm_dirty_bit.h
index a4cda8cdab24..08c67e7a17ac 100644
--- a/arch/arm64/include/asm/kvm_dirty_bit.h
+++ b/arch/arm64/include/asm/kvm_dirty_bit.h
@@ -1,7 +1,7 @@
 /* SPDX-License-Identifier: GPL-2.0-only */
 /*
- * Copyright (C) 2026 ARM Ltd.
- * Author: Leonardo Bras <leo.bras@arm.com>
+ * Copyright (C) 2026 Huawei Technologies Co., Ltd
+ * Author: Tian Zheng <zhengtian10@huawei.com>
  */
 
 #ifndef __ARM64_KVM_DIRTY_BIT_H__
diff --git a/arch/arm64/kernel/cpufeature.c b/arch/arm64/kernel/cpufeature.c
index aa327eebaf1c..a1fd05ac49cd 100644
--- a/arch/arm64/kernel/cpufeature.c
+++ b/arch/arm64/kernel/cpufeature.c
@@ -2131,9 +2131,9 @@ static bool hvhe_possible(const struct arm64_cpu_capabilities *entry,
 	return arm64_test_sw_feature_override(ARM64_SW_FEATURE_OVERRIDE_HVHE);
 }
 
-static bool has_vhe_hdbss(const struct arm64_cpu_capabilities *entry, int cope)
+static bool has_vhe_hdbss(const struct arm64_cpu_capabilities *entry, int scope)
 {
-	return is_kernel_in_hyp_mode() && has_cpuid_feature(entry, cope);
+	return is_kernel_in_hyp_mode() && has_cpuid_feature(entry, scope);
 }
 
 bool cpu_supports_bbml2_noabort(void)
diff --git a/arch/arm64/kvm/dirty_bit.c b/arch/arm64/kvm/dirty_bit.c
index c5bf866c23ef..5e30c5267f6d 100644
--- a/arch/arm64/kvm/dirty_bit.c
+++ b/arch/arm64/kvm/dirty_bit.c
@@ -1,7 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
- * Copyright (C) 2026 ARM Ltd.
- * Author: Leonardo Bras <leo.bras@arm.com>
+ * Copyright (C) 2026 Huawei Technologies Co., Ltd
+ * Author: Tian Zheng <zhengtian10@huawei.com>
  */
 
 #include <asm/kvm_dirty_bit.h>
