From 6c5285846c2bf18aae01d753bd9bb4ccb6e41059 Mon Sep 17 00:00:00 2001
From: AkiraZheng <1428384878@qq.com>
Date: Thu, 27 Aug 2026 23:45:04 +0800
Subject: [PATCH 19/19] KVM: arm64: HDBSS: Use KVM_REQ_RELOAD_STAGE2 for
 enable/disable, kick for sync

Align HDBSS enable/disable with the KVM_REQ_RELOAD_STAGE2 approach
proposed by Leonardo Bras in his RFC series.

Enable/disable (KVM_REQ_RELOAD_STAGE2):
  Define KVM_REQ_RELOAD_STAGE2 as KVM_ARCH_REQ_FLAGS(12,
  KVM_REQUEST_WAIT | KVM_REQUEST_NO_WAKEUP), matching Leo's RFC.
  kvm_arm_enable/disable_hdbss_global() now sends this request instead
  of kvm_vcpu_kick.  The request handler in check_vcpu_requests()
  calls __load_stage2(hw_mmu) to reload VTCR_EL2 before the next
  guest entry, ensuring hardware matches software with no stale window.

  This closes the stale-hardware window that existed with kvm_vcpu_kick:
  previously, modifying the software VTCR and kicking vCPUs did not
  reload vtcr_el2 within the same KVM_RUN (only at the next vcpu_load).
  Now the request handler reloads VTCR before re-entering guest,
  eliminating the window where software says enabled/disabled but
  hardware still has the old state.

sync_dirty_log (kvm_vcpu_kick):
  kvm_arch_sync_dirty_log() uses kvm_for_each_vcpu + kvm_vcpu_kick,
  matching x86 kvm_arch_sync_dirty_log().  The flush happens on every
  VM exit; the kick is sufficient because the dirty-log protocol
  (GET/CLEAR) tolerates concurrent bitmap writes.

Base commit: 0e35b9b6ec0f

Signed-off-by: AkiraZheng <1428384878@qq.com>
---
 arch/arm64/include/asm/kvm_host.h |  3 ++-
 arch/arm64/kvm/arm.c              | 31 ++++++++++++++++++++++++++-----
 arch/arm64/kvm/dirty_bit.c        | 21 +++++++++------------
 3 files changed, 37 insertions(+), 18 deletions(-)

diff --git a/arch/arm64/include/asm/kvm_host.h b/arch/arm64/include/asm/kvm_host.h
index 02035fd913af..ecf54b21d97d 100644
--- a/arch/arm64/include/asm/kvm_host.h
+++ b/arch/arm64/include/asm/kvm_host.h
@@ -55,7 +55,8 @@
 #define KVM_REQ_GUEST_HYP_IRQ_PENDING	KVM_ARCH_REQ(9)
 #define KVM_REQ_MAP_L1_VNCR_EL2		KVM_ARCH_REQ(10)
 #define KVM_REQ_VGIC_PROCESS_UPDATE	KVM_ARCH_REQ(11)
-#define KVM_REQ_FLUSH_HDBSS		KVM_ARCH_REQ(12)
+#define KVM_REQ_RELOAD_STAGE2 \
+	KVM_ARCH_REQ_FLAGS(12, KVM_REQUEST_WAIT | KVM_REQUEST_NO_WAKEUP)
 
 #define KVM_DIRTY_LOG_MANUAL_CAPS   (KVM_DIRTY_LOG_MANUAL_PROTECT_ENABLE | \
 				     KVM_DIRTY_LOG_INITIALLY_SET)
diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index 44755954727c..87e43ac5b4eb 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -1260,6 +1260,21 @@ static int check_vcpu_requests(struct kvm_vcpu *vcpu)
 		if (kvm_check_request(KVM_REQ_SUSPEND, vcpu))
 			return kvm_vcpu_suspend(vcpu);
 
+		if (kvm_check_request(KVM_REQ_RELOAD_STAGE2, vcpu)) {
+			unsigned long flags;
+
+			/*
+			 * Reload VTCR_EL2 from the (possibly modified)
+			 * software state before the next guest entry.
+			 * This ensures hardware matches software, closing
+			 * the stale-hardware window that would otherwise
+			 * exist until the next vcpu_load.
+			 */
+			local_irq_save(flags);
+			__load_stage2(vcpu->arch.hw_mmu);
+			local_irq_restore(flags);
+		}
+
 		if (kvm_dirty_ring_check_request(vcpu))
 			return 0;
 
@@ -2089,16 +2104,22 @@ long kvm_arch_vcpu_unlocked_ioctl(struct file *filp, unsigned int ioctl,
 
 void kvm_arch_sync_dirty_log(struct kvm *kvm, struct kvm_memory_slot *memslot)
 {
+	struct kvm_vcpu *vcpu;
+	unsigned long i;
+
 	/*
-	 * Kick all vCPUs out of guest mode.  The HDBSS buffer is flushed
-	 * in the VM exit path (before handle_exit_early), so ensuring
-	 * vCPUs are in root mode guarantees all buffered dirty entries
-	 * have been pushed to the dirty bitmap or dirty ring.
+	 * Kick running vCPUs out of guest mode.  The HDBSS buffer is
+	 * flushed on every VM exit (before handle_exit_early), so only
+	 * vCPUs currently in guest mode can hold unflushed entries.  The
+	 * dirty-log protocol (GET_DIRTY_LOG / CLEAR_DIRTY_LOG) tolerates
+	 * concurrent bitmap writes: bits set after the snapshot survive
+	 * the clear and are reported in the next iteration.
 	 */
 	if (!kvm_hdbss_enabled(kvm))
 		return;
 
-	kvm_make_all_cpus_request(kvm, KVM_REQ_OUTSIDE_GUEST_MODE);
+	kvm_for_each_vcpu(i, vcpu, kvm)
+		kvm_vcpu_kick(vcpu);
 }
 
 static int kvm_vm_ioctl_set_device_addr(struct kvm *kvm,
diff --git a/arch/arm64/kvm/dirty_bit.c b/arch/arm64/kvm/dirty_bit.c
index 59ed944dd7e5..5be004dce3ae 100644
--- a/arch/arm64/kvm/dirty_bit.c
+++ b/arch/arm64/kvm/dirty_bit.c
@@ -140,9 +140,10 @@ int kvm_handle_hdbss_fault(struct kvm_vcpu *vcpu)
  * by kvm_arch_commit_memory_region() under kvm->slots_lock.
  *
  * HDBSS buffers are pre-allocated at vCPU create time (PML-style), so
- * this function only sets VTCR bits and kicks all vCPUs out of guest
- * mode to reload the new VTCR value on next entry. No buffer allocation
- * or deallocation happens here.
+ * this function only sets VTCR bits and sends KVM_REQ_RELOAD_STAGE2 to
+ * all vCPUs.  The request handler reloads VTCR_EL2 before the next
+ * guest entry, ensuring hardware matches software with no stale window.
+ * No buffer allocation or deallocation happens here.
  */
 static void kvm_arm_enable_hdbss_global(struct kvm *kvm)
 {
@@ -160,11 +161,7 @@ static void kvm_arm_enable_hdbss_global(struct kvm *kvm)
 		 (kvm->arch.hdbss_buffer_size ?: KVM_ARM_HDBSS_DEFAULT_SIZE) /
 		 sizeof(u64));
 
-	/*
-	 * We should kick vcpus out of guest mode here to load new
-	 * vtcr value to vtcr_el2 register when re-enter guest mode.
-	 */
-	kvm_make_all_cpus_request(kvm, KVM_REQ_OUTSIDE_GUEST_MODE);
+	kvm_make_all_cpus_request(kvm, KVM_REQ_RELOAD_STAGE2);
 }
 
 void kvm_arm_disable_hdbss_global(struct kvm *kvm)
@@ -178,11 +175,11 @@ void kvm_arm_disable_hdbss_global(struct kvm *kvm)
 	kvm_info("HDBSS disabled\n");
 
 	/*
-	 * We should kick vcpus out of guest mode here to load new
-	 * vtcr value to vtcr_el2 register when re-enter guest mode.
-	 * Buffers are freed at vCPU destroy time, not here.
+	 * Buffers are freed at vCPU destroy time, not here.  The request
+	 * handler reloads VTCR_EL2 before the next guest entry, closing
+	 * the stale-hardware window.
 	 */
-	kvm_make_all_cpus_request(kvm, KVM_REQ_OUTSIDE_GUEST_MODE);
+	kvm_make_all_cpus_request(kvm, KVM_REQ_RELOAD_STAGE2);
 }
 
 void kvm_arm_hdbss_on_dirty_logging_change(struct kvm *kvm, int nr_memslots_logging)
-- 
