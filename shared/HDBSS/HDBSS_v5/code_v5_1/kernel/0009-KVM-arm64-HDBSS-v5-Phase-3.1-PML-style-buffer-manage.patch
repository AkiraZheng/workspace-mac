From b60a0772e076c200519ec5e1c2649ae5d7491a6b Mon Sep 17 00:00:00 2001
From: AkiraZheng <1428384878@qq.com>
Date: Sat, 15 Aug 2026 09:09:16 +0800
Subject: [PATCH 09/14] KVM: arm64: HDBSS v5 Phase 3.1: PML-style buffer
 management
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Refactor HDBSS buffer lifecycle and locking following the x86 PML
design pattern, while preserving the multi-path flush approach
requested by Marc Zyngier (flush at vcpu_put time, not on every exit).

Buffer lifecycle (PML pattern):
- Allocate buffer at vCPU create time when system_supports_hdbss()
- Free buffer at vCPU destroy time (kvm_arm_vcpu_destroy)
- Buffer always exists during vCPU lifetime, regardless of whether
  dirty logging is enabled — same as x86 PML's pml_pg

Enable/disable (VTCR-only, no enable_hdbss flag):
- kvm_arm_enable_hdbss_global(): just set VTCR bits + kick all vCPUs
  via KVM_REQ_OUTSIDE_GUEST_MODE
- kvm_arm_disable_hdbss_global(): just clear VTCR bits + kick
- No buffer alloc/free during enable/disable
- Remove enable_hdbss field; use kvm->arch.mmu.vtcr & VTCR_EL2_HDBSS
- Remove smp_store_release/smp_load_acquire — no longer needed since
  VTCR is only modified under slots_lock and vCPUs read it on entry

Multi-path flush (per Marc Zyngier's v1 review):
- kvm_arch_vcpu_put(): flush when vCPU exits to userspace or is
  scheduled out (Marc: 'this should be moved to put-time')
- KVM_REQ_FLUSH_HDBSS: set by kvm_handle_hdbss_fault() on buffer full,
  processed in check_vcpu_requests()
- sync_dirty_log: kvm_make_all_cpus_request(KVM_REQ_FLUSH_HDBSS |
  KVM_REQUEST_WAIT) to kick all vCPUs and flush synchronously
- kvm_vcpu_put_vhe(): save HDBSSPROD_EL2 for cross-CPU access
- No unconditional flush on every exit (Marc objected to this in v1)

kvm_flush_hdbss_buffer() cleanup:
- Replace mmu_lock with SRCU — mark_page_dirty_in_slot() only does
  atomic bit-sets, no mmu_lock needed; SRCU protects memslot lookup
- Eliminates ABBA deadlock: vcpu_put (scheduler holds rq->lock) ->
  kvm_flush_hdbss_buffer -> mmu_lock vs mmu_lock -> wake_up -> rq->lock
- x86 PML doesn't need explicit srcu_read_lock because vcpu_enter_guest
  holds SRCU before calling handle_exit; arm64 doesn't, so we add it

struct vcpu_hdbss_state: replace base_phys with struct page *hdbss_pg
- Eliminates page_to_phys/phys_to_page round-trip conversions
- Eliminates phys 0 bug (S11) — NULL check is reliable
- Matches x86 PML's struct page *pml_pg

Issues resolved by this refactoring:
- S19: no cross-CPU vCPU state mutation (buffer alloc at create, VTCR
  is shared but only ioctl thread writes)
- S11: phys 0 bug eliminated by struct page * approach
- 3.6: enable_hdbss removed, no memory ordering needed
- 4.1: no UAF on disable — buffer never freed during disable
- 4.2: no ABBA deadlock — mmu_lock replaced with SRCU
- 4.3: SRCU protection added for memslot lookup

Based on community_conversion.md Phase 3-4 tasks, redesigned following
x86 PML buffer lifecycle pattern while preserving Marc Zyngier's
requirement for flush at vcpu_put time.
Base commit: 0e35b9b6ec0f

Signed-off-by: AkiraZheng <1428384878@qq.com>
---
 arch/arm64/include/asm/kvm_host.h |  3 +-
 arch/arm64/kvm/arm.c              | 23 +++++-----
 arch/arm64/kvm/dirty_bit.c        | 73 ++++++++++---------------------
 arch/arm64/kvm/hyp/vhe/switch.c   |  4 +-
 4 files changed, 38 insertions(+), 65 deletions(-)

diff --git a/arch/arm64/include/asm/kvm_host.h b/arch/arm64/include/asm/kvm_host.h
index fc1175cae7ff..6e3ff2132585 100644
--- a/arch/arm64/include/asm/kvm_host.h
+++ b/arch/arm64/include/asm/kvm_host.h
@@ -55,7 +55,7 @@
 #define KVM_REQ_GUEST_HYP_IRQ_PENDING	KVM_ARCH_REQ(9)
 #define KVM_REQ_MAP_L1_VNCR_EL2		KVM_ARCH_REQ(10)
 #define KVM_REQ_VGIC_PROCESS_UPDATE	KVM_ARCH_REQ(11)
-#define KVM_REQ_FLUSH_HDBSS			KVM_ARCH_REQ(12)
+#define KVM_REQ_FLUSH_HDBSS		KVM_ARCH_REQ(12)
 
 #define KVM_DIRTY_LOG_MANUAL_CAPS   (KVM_DIRTY_LOG_MANUAL_PROTECT_ENABLE | \
 				     KVM_DIRTY_LOG_INITIALLY_SET)
@@ -422,7 +422,6 @@ struct kvm_arch {
 	struct kvm_protected_vm pkvm;
 
 	/* HDBSS: per-VM dirty tracking state */
-	bool enable_hdbss;
 	unsigned int hdbss_order;
 
 #ifdef CONFIG_PTDUMP_STAGE2_DEBUGFS
diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index a68f729fef39..32ca0202943b 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -333,9 +333,10 @@ void kvm_arch_destroy_vm(struct kvm *kvm)
 	/*
 	 * Userspace may destroy the VM without disabling dirty logging,
 	 * so the auto-disable path is never reached. Force disable HDBSS
-	 * here to ensure vCPU buffers are freed and prevent memory leaks.
+	 * here to kick all vCPUs out of guest mode before kvm_destroy_vcpus
+	 * frees their buffers, preventing hardware UAF.
 	 */
-	if (kvm->arch.enable_hdbss)
+	if (kvm->arch.mmu.vtcr & VTCR_EL2_HDBSS)
 		kvm_arm_disable_hdbss_global(kvm);
 
 	kvm_uninit_stage2_mmu(kvm);
@@ -589,13 +590,11 @@ int kvm_arch_vcpu_create(struct kvm_vcpu *vcpu)
 		return err;
 	}
 
-	if (vcpu->kvm->arch.enable_hdbss) {
-		err = kvm_arm_vcpu_alloc_hdbss(vcpu);
-		if (err) {
-			kvm_unshare_hyp(vcpu, vcpu + 1);
-			kvm_vgic_vcpu_destroy(vcpu);
-			return err;
-		}
+	err = kvm_arm_vcpu_alloc_hdbss(vcpu);
+	if (err) {
+		kvm_unshare_hyp(vcpu, vcpu + 1);
+		kvm_vgic_vcpu_destroy(vcpu);
+		return err;
 	}
 
 	return 0;
@@ -781,7 +780,7 @@ void kvm_arch_vcpu_put(struct kvm_vcpu *vcpu)
 		kvm_vcpu_put_hw_mmu(vcpu);
 	kvm_arm_vmid_clear_active();
 
-	if (vcpu->kvm->arch.enable_hdbss)
+	if (vcpu->kvm->arch.mmu.vtcr & VTCR_EL2_HDBSS)
 		kvm_flush_hdbss_buffer(vcpu);
 
 	vcpu_clear_on_unsupported_cpu(vcpu);
@@ -2005,10 +2004,10 @@ void kvm_arch_sync_dirty_log(struct kvm *kvm, struct kvm_memory_slot *memslot)
 {
 	/*
 	 * Flush all CPUs' dirty log buffers to the dirty_bitmap.  Called
-	 * before reporting dirty_bitmap to userspace. Send a request with
+	 * before reporting dirty_bitmap to userspace.  Send a request with
 	 * KVM_REQUEST_WAIT to flush buffer synchronously.
 	 */
-	if (!kvm->arch.enable_hdbss)
+	if (!(kvm->arch.mmu.vtcr & VTCR_EL2_HDBSS))
 		return;
 
 	kvm_make_all_cpus_request(kvm, KVM_REQ_FLUSH_HDBSS | KVM_REQUEST_WAIT);
diff --git a/arch/arm64/kvm/dirty_bit.c b/arch/arm64/kvm/dirty_bit.c
index 8a627e6c5126..ef3c54f9d7d0 100644
--- a/arch/arm64/kvm/dirty_bit.c
+++ b/arch/arm64/kvm/dirty_bit.c
@@ -10,6 +10,7 @@
 #include <linux/gfp.h>
 #include <linux/kconfig.h>
 #include <linux/mm.h>
+#include <linux/srcu.h>
 
 int kvm_arm_vcpu_alloc_hdbss(struct kvm_vcpu *vcpu)
 {
@@ -49,8 +50,9 @@ void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu)
 	int idx, curr_idx;
 	u64 *hdbss_buf;
 	struct kvm *kvm = vcpu->kvm;
+	int srcu_idx;
 
-	if (!kvm->arch.enable_hdbss)
+	if (!(kvm->arch.mmu.vtcr & VTCR_EL2_HDBSS))
 		return;
 
 	curr_idx = HDBSSPROD_IDX(read_sysreg_s(SYS_HDBSSPROD_EL2));
@@ -63,7 +65,7 @@ void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu)
 	if (!hdbss_buf)
 		return;
 
-	guard(write_lock_irqsave)(&vcpu->kvm->mmu_lock);
+	srcu_idx = srcu_read_lock(&kvm->srcu);
 	for (idx = 0; idx < curr_idx; idx++) {
 		u64 gpa;
 
@@ -74,6 +76,7 @@ void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu)
 		gpa &= HDBSS_ENTRY_IPA;
 		kvm_vcpu_mark_page_dirty(vcpu, gpa >> PAGE_SHIFT);
 	}
+	srcu_read_unlock(&kvm->srcu, srcu_idx);
 
 	/* reset HDBSS index */
 	write_sysreg_s(0, SYS_HDBSSPROD_EL2);
@@ -115,80 +118,52 @@ int kvm_handle_hdbss_fault(struct kvm_vcpu *vcpu)
  * Called from kvm_arm_hdbss_on_dirty_logging_change() which is invoked
  * by kvm_arch_commit_memory_region() under kvm->slots_lock.
  *
- * If buffer allocation fails, HDBSS remains disabled and dirty tracking
- * falls back to the traditional software-based approach (PTE write-protect
- * + software dirty marking). This does not affect correctness; dirty
- * logging remains functional without HDBSS.
+ * HDBSS buffers are pre-allocated at vCPU create time (PML-style), so
+ * this function only sets VTCR bits and kicks all vCPUs out of guest
+ * mode to reload the new VTCR value on next entry. No buffer allocation
+ * or deallocation happens here.
  */
-static int kvm_arm_enable_hdbss_global(struct kvm *kvm)
+static void kvm_arm_enable_hdbss_global(struct kvm *kvm)
 {
-	int err;
-	unsigned long i;
-	struct kvm_vcpu *vcpu;
-
 	if (!system_supports_hdbss())
-		return 0;
+		return;
 
 	if (kvm->dirty_ring_size) /* Don't support HDBSS in dirty ring mode */
-		return 0;
+		return;
 
-	if (kvm->arch.enable_hdbss) /* Already On */
-		return 0;
+	if (kvm->arch.mmu.vtcr & VTCR_EL2_HDBSS) /* Already On */
+		return;
 
 	/* Turn it on */
-	kvm_for_each_vcpu(i, vcpu, kvm) {
-		err = kvm_arm_vcpu_alloc_hdbss(vcpu);
-		if (err)
-			goto error_alloc;
-	}
-
-	smp_store_release(&kvm->arch.enable_hdbss, true);
 	kvm->arch.mmu.vtcr |= VTCR_EL2_HD | VTCR_EL2_HDBSS | VTCR_EL2_HA;
 
 	/*
 	 * We should kick vcpus out of guest mode here to load new
 	 * vtcr value to vtcr_el2 register when re-enter guest mode.
 	 */
-	kvm_for_each_vcpu(i, vcpu, kvm)
-		kvm_vcpu_kick(vcpu);
-
-	return 0;
-
-error_alloc:
-	kvm_for_each_vcpu(i, vcpu, kvm)
-		if (vcpu->arch.hdbss.hdbss_pg)
-			kvm_arm_vcpu_free_hdbss(vcpu);
-
-	pr_warn_once("kvm: failed to allocate HDBSS buffers, "
-		     "falling back to software dirty tracking\n");
-	return -ENOMEM;
+	kvm_make_all_cpus_request(kvm, KVM_REQ_OUTSIDE_GUEST_MODE);
 }
 
 void kvm_arm_disable_hdbss_global(struct kvm *kvm)
 {
-	unsigned long i;
-	struct kvm_vcpu *vcpu;
-
-	if (!kvm->arch.enable_hdbss) /* Already Off */
+	if (!(kvm->arch.mmu.vtcr & VTCR_EL2_HDBSS)) /* Already Off */
 		return;
 
 	/* Turn it off */
 	kvm->arch.mmu.vtcr &= ~(VTCR_EL2_HD | VTCR_EL2_HDBSS | VTCR_EL2_HA);
 
-	kvm_for_each_vcpu(i, vcpu, kvm)
-		kvm_arm_vcpu_free_hdbss(vcpu);
-
-	kvm->arch.enable_hdbss = false;
+	/*
+	 * We should kick vcpus out of guest mode here to load new
+	 * vtcr value to vtcr_el2 register when re-enter guest mode.
+	 * Buffers are freed at vCPU destroy time, not here.
+	 */
+	kvm_make_all_cpus_request(kvm, KVM_REQ_OUTSIDE_GUEST_MODE);
 }
 
 void kvm_arm_hdbss_on_dirty_logging_change(struct kvm *kvm, int nr_memslots_logging)
 {
-	/*
-	 * Called from kvm_arch_commit_memory_region() under kvm->slots_lock.
-	 * All state transitions are serialized by slots_lock.
-	 */
-	if (nr_memslots_logging > 0 && !kvm->arch.enable_hdbss)
+	if (nr_memslots_logging > 0 && !(kvm->arch.mmu.vtcr & VTCR_EL2_HDBSS))
 		kvm_arm_enable_hdbss_global(kvm);
-	else if (nr_memslots_logging == 0 && kvm->arch.enable_hdbss)
+	else if (nr_memslots_logging == 0 && (kvm->arch.mmu.vtcr & VTCR_EL2_HDBSS))
 		kvm_arm_disable_hdbss_global(kvm);
 }
diff --git a/arch/arm64/kvm/hyp/vhe/switch.c b/arch/arm64/kvm/hyp/vhe/switch.c
index 5575a2ae29c8..a0e8f4cd1812 100644
--- a/arch/arm64/kvm/hyp/vhe/switch.c
+++ b/arch/arm64/kvm/hyp/vhe/switch.c
@@ -218,7 +218,7 @@ static void __load_hdbss(struct kvm_vcpu *vcpu)
 {
 	struct kvm *kvm = vcpu->kvm;
 
-	if (!smp_load_acquire(&kvm->arch.enable_hdbss))
+	if (!(kvm->arch.mmu.vtcr & VTCR_EL2_HDBSS))
 		return;
 
 	write_sysreg_s(vcpu->arch.hdbss.hdbssbr_el2, SYS_HDBSSBR_EL2);
@@ -239,7 +239,7 @@ void kvm_vcpu_load_vhe(struct kvm_vcpu *vcpu)
 
 void kvm_vcpu_put_vhe(struct kvm_vcpu *vcpu)
 {
-	if (smp_load_acquire(&vcpu->kvm->arch.enable_hdbss))
+	if (vcpu->kvm->arch.mmu.vtcr & VTCR_EL2_HDBSS)
 		vcpu->arch.hdbss.hdbssprod_el2 = read_sysreg_s(SYS_HDBSSPROD_EL2);
 
 	__vcpu_put_deactivate_traps(vcpu);
-- 
2.43.0

