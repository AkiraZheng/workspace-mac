From f928b0b1695c1353a0134f9f89b5bd3667a89c9f Mon Sep 17 00:00:00 2001
From: AkiraZheng <1428384878@qq.com>
Date: Fri, 21 Aug 2026 12:22:22 +0800
Subject: [PATCH 17/18] KVM: arm64: HDBSS: Add kvm_info debug messages for key
 HDBSS events

Add kvm_info() calls at low-frequency HDBSS state transitions to aid
debugging and monitoring via dmesg:

- kvm_arch_dirty_ring_size_updated(): auto-config result (ring_entries,
  hdbss_bytes, hdbss_entries, rsvd, soft_limit)
- kvm_arm_vcpu_alloc_hdbss(): buffer allocation (vcpu, size, order, sz)
- kvm_arm_enable_hdbss_global(): HDBSS enable (buffer_size, entries)
- kvm_arm_disable_hdbss_global(): HDBSS disable
- kvm_handle_hdbss_fault() FSC_OK: buffer full (vcpu, prod_idx)

High-frequency events (flush on every VM exit, HDBSSPROD save in
vcpu_put) are intentionally not logged to avoid flooding dmesg.

Base commit: 0e35b9b6ec0f

Signed-off-by: AkiraZheng <1428384878@qq.com>
---
 arch/arm64/kvm/arm.c       |  5 +++++
 arch/arm64/kvm/dirty_bit.c | 12 ++++++++++++
 2 files changed, 17 insertions(+)

diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index 221369230e9b..b25f4b4a67e6 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -279,6 +279,11 @@ void kvm_arch_dirty_ring_size_updated(struct kvm *kvm)
 			    KVM_ARM_HDBSS_MAX_SIZE);
 
 	kvm->arch.hdbss_buffer_size = hdbss_bytes;
+
+	kvm_info("HDBSS auto-config: ring_entries=%u hdbss_bytes=%u hdbss_entries=%u rsvd=%u soft_limit=%u\n",
+		 ring_entries, hdbss_bytes, hdbss_bytes / sizeof(u64),
+		 KVM_DIRTY_RING_RSVD_ENTRIES + hdbss_bytes / sizeof(u64),
+		 ring_entries - KVM_DIRTY_RING_RSVD_ENTRIES - hdbss_bytes / sizeof(u64));
 }
 
 /**
diff --git a/arch/arm64/kvm/dirty_bit.c b/arch/arm64/kvm/dirty_bit.c
index 4d31db8e3c40..59ed944dd7e5 100644
--- a/arch/arm64/kvm/dirty_bit.c
+++ b/arch/arm64/kvm/dirty_bit.c
@@ -38,6 +38,9 @@ int kvm_arm_vcpu_alloc_hdbss(struct kvm_vcpu *vcpu)
 		.buddy_order = buddy_order,
 	};
 
+	kvm_info("HDBSS buffer alloc: vcpu=%d size=%u bytes order=%u sz=%u\n",
+		 vcpu->vcpu_id, size, buddy_order, sz_encoded);
+
 	return 0;
 }
 
@@ -115,6 +118,8 @@ int kvm_handle_hdbss_fault(struct kvm_vcpu *vcpu)
 		 * Buffer full.  No need to set a flush request — the
 		 * exit path flushes unconditionally before handle_exit.
 		 */
+		kvm_info("HDBSS buffer full: vcpu=%d prod_idx=%u\n",
+			 vcpu->vcpu_id, HDBSSPROD_IDX(prod));
 		return 1;
 	case HDBSSPROD_EL2_FSC_ExternalAbort:
 	case HDBSSPROD_EL2_FSC_GPF:
@@ -150,6 +155,11 @@ static void kvm_arm_enable_hdbss_global(struct kvm *kvm)
 	/* Turn it on */
 	kvm->arch.mmu.vtcr |= VTCR_EL2_HD | VTCR_EL2_HDBSS | VTCR_EL2_HA;
 
+	kvm_info("HDBSS enabled: buffer_size=%u bytes (%u entries)\n",
+		 kvm->arch.hdbss_buffer_size ?: KVM_ARM_HDBSS_DEFAULT_SIZE,
+		 (kvm->arch.hdbss_buffer_size ?: KVM_ARM_HDBSS_DEFAULT_SIZE) /
+		 sizeof(u64));
+
 	/*
 	 * We should kick vcpus out of guest mode here to load new
 	 * vtcr value to vtcr_el2 register when re-enter guest mode.
@@ -165,6 +175,8 @@ void kvm_arm_disable_hdbss_global(struct kvm *kvm)
 	/* Turn it off */
 	kvm->arch.mmu.vtcr &= ~(VTCR_EL2_HD | VTCR_EL2_HDBSS | VTCR_EL2_HA);
 
+	kvm_info("HDBSS disabled\n");
+
 	/*
 	 * We should kick vcpus out of guest mode here to load new
 	 * vtcr value to vtcr_el2 register when re-enter guest mode.
-- 
