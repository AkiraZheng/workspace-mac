From e14f86a30044c23e860724b93a4f1a62f80c648b Mon Sep 17 00:00:00 2001
From: AkiraZheng <1428384878@qq.com>
Date: Sun, 16 Aug 2026 08:39:31 +0800
Subject: [PATCH 13/17] KVM: arm64: HDBSS v5 Phase 7: Add HDBSS buffer size
 ioctl for dirty-bitmap mode

Add KVM_CAP_ARM_HDBSS_BUFFER_SIZE (251) to allow userspace to
configure the HDBSS buffer size per-VM before vCPUs are created.

Interface (consistent with KVM_CAP_DIRTY_LOG_RING):
- KVM_ENABLE_CAP: args[0] is buffer size in bytes
- KVM_CHECK_EXTENSION: returns current size (per-VM) or max size
  (global query)
- Size must be a power of 2, in range [PAGE_SIZE, SZ_2M]
- Must be set before vCPU creation, mutually exclusive with dirty ring
- Default: PAGE_SIZE (one full page per vCPU) if not configured

Kernel changes:
- include/uapi/linux/kvm.h: new capability KVM_CAP_ARM_HDBSS_BUFFER_SIZE
- kvm_host.h: add hdbss_buffer_size (u32, bytes) to kvm_arch;
  add buddy_order to vcpu_hdbss_state
- kvm_dirty_bit.h: KVM_ARM_HDBSS_DEFAULT_SIZE / KVM_ARM_HDBSS_MAX_SIZE
- arm.c: CHECK_EXTENSION + ENABLE_CAP handlers
- dirty_bit.c: kvm_arm_vcpu_alloc_hdbss() reads hdbss_buffer_size,
  computes buddy_order and SZ encoding; kvm_arm_vcpu_free_hdbss()
  uses stored buddy_order (fixes 16KB/64KB page bug where SZ encoding
  was incorrectly used as buddy order); kvm_flush_hdbss_buffer()
  uses min(curr_idx, entries) as flush loop upper bound

Base commit: 0e35b9b6ec0f

Signed-off-by: AkiraZheng <1428384878@qq.com>
---
 arch/arm64/include/asm/kvm_dirty_bit.h |  7 ++++++
 arch/arm64/include/asm/kvm_host.h      |  4 +++
 arch/arm64/kvm/arm.c                   | 34 ++++++++++++++++++++++++++
 arch/arm64/kvm/dirty_bit.c             | 23 ++++++++++++-----
 include/uapi/linux/kvm.h               |  1 +
 5 files changed, 63 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/include/asm/kvm_dirty_bit.h b/arch/arm64/include/asm/kvm_dirty_bit.h
index c7b9e7f52fba..b9c029dec67f 100644
--- a/arch/arm64/include/asm/kvm_dirty_bit.h
+++ b/arch/arm64/include/asm/kvm_dirty_bit.h
@@ -9,6 +9,7 @@
 
 #include <asm/kvm_pgtable.h>
 #include <asm/sysreg.h>
+#include <linux/sizes.h>
 
 /* HDBSS entry field definitions */
 #define HDBSS_ENTRY_VALID	BIT(0)
@@ -19,6 +20,12 @@
 #define HDBSS_ENTRY_TTWL_RESV HDBSS_ENTRY_TTWL(-4)
 #define HDBSS_ENTRY_IPA	GENMASK_ULL(55, 12)
 
+/* Default HDBSS buffer size: one full page per vCPU */
+#define KVM_ARM_HDBSS_DEFAULT_SIZE  PAGE_SIZE
+
+/* Maximum HDBSS buffer size: 2MB (HDBSSBR_EL2_SZ_2MB, hardware limit) */
+#define KVM_ARM_HDBSS_MAX_SIZE      SZ_2M
+
 /*
  * VM-level HDBSS check — L1 only, does not filter nested (L2).
  *
diff --git a/arch/arm64/include/asm/kvm_host.h b/arch/arm64/include/asm/kvm_host.h
index 166688ec29d3..02035fd913af 100644
--- a/arch/arm64/include/asm/kvm_host.h
+++ b/arch/arm64/include/asm/kvm_host.h
@@ -421,6 +421,9 @@ struct kvm_arch {
 	 */
 	struct kvm_protected_vm pkvm;
 
+	/* HDBSS: per-VM buffer size in bytes (0 = not configured, use default) */
+	u32 hdbss_buffer_size;
+
 #ifdef CONFIG_PTDUMP_STAGE2_DEBUGFS
 	/* Nested virtualization info */
 	struct dentry *debugfs_nv_dentry;
@@ -843,6 +846,7 @@ struct vcpu_hdbss_state {
 	struct page *hdbss_pg;   /* HDBSS buffer page */
 	u64 hdbssbr_el2;         /* load directly */
 	u64 hdbssprod_el2;       /* save directly */
+	unsigned int buddy_order; /* allocation order for __free_pages */
 };
 
 struct vncr_tlb;
diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index cf29c9f7eace..127d8a4b70a0 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -19,6 +19,7 @@
 #include <linux/kvm.h>
 #include <linux/kvm_irqfd.h>
 #include <linux/irqbypass.h>
+#include <linux/log2.h>
 #include <linux/sched/stat.h>
 #include <linux/psci.h>
 #include <trace/events/kvm.h>
@@ -203,6 +204,31 @@ int kvm_vm_ioctl_enable_cap(struct kvm *kvm,
 		r = 0;
 		set_bit(KVM_ARCH_FLAG_EXIT_SEA, &kvm->arch.flags);
 		break;
+	case KVM_CAP_ARM_HDBSS_BUFFER_SIZE: {
+		u64 size = cap->args[0];
+
+		if (!system_supports_hdbss())
+			break;
+		if (kvm->dirty_ring_size)
+			break;
+		if (size < KVM_ARM_HDBSS_DEFAULT_SIZE ||
+		    size > KVM_ARM_HDBSS_MAX_SIZE)
+			break;
+		if (!is_power_of_2(size))
+			break;
+
+		mutex_lock(&kvm->lock);
+		if (kvm->created_vcpus) {
+			r = -EINVAL;
+		} else if (kvm->arch.hdbss_buffer_size) {
+			r = -EBUSY;
+		} else {
+			kvm->arch.hdbss_buffer_size = size;
+			r = 0;
+		}
+		mutex_unlock(&kvm->lock);
+		break;
+	}
 	default:
 		break;
 	}
@@ -496,6 +522,14 @@ int kvm_vm_ioctl_check_extension(struct kvm *kvm, long ext)
 		else
 			r = KVM_ARM_EAGER_SPLIT_CHUNK_SIZE_DEFAULT;
 		break;
+	case KVM_CAP_ARM_HDBSS_BUFFER_SIZE:
+		if (!system_supports_hdbss())
+			r = 0;
+		else if (kvm)
+			r = kvm->arch.hdbss_buffer_size ?: KVM_ARM_HDBSS_DEFAULT_SIZE;
+		else
+			r = KVM_ARM_HDBSS_MAX_SIZE;
+		break;
 	case KVM_CAP_ARM_SUPPORTED_BLOCK_SIZES:
 		r = kvm_supported_block_sizes();
 		break;
diff --git a/arch/arm64/kvm/dirty_bit.c b/arch/arm64/kvm/dirty_bit.c
index 4024c234c63d..7fc41902b2ba 100644
--- a/arch/arm64/kvm/dirty_bit.c
+++ b/arch/arm64/kvm/dirty_bit.c
@@ -9,24 +9,33 @@
 #include <asm/sysreg.h>
 #include <linux/gfp.h>
 #include <linux/kconfig.h>
+#include <linux/log2.h>
 #include <linux/mm.h>
 #include <linux/srcu.h>
 
 int kvm_arm_vcpu_alloc_hdbss(struct kvm_vcpu *vcpu)
 {
 	struct page *hdbss_pg;
+	u32 size;
+	unsigned int buddy_order;
+	u32 sz_encoded;
 
 	if (vcpu->arch.hdbss.hdbss_pg || !system_supports_hdbss())
 		return 0;
 
-	hdbss_pg = alloc_page(GFP_KERNEL_ACCOUNT);
+	size = vcpu->kvm->arch.hdbss_buffer_size ?: KVM_ARM_HDBSS_DEFAULT_SIZE;
+	buddy_order = get_order(size);
+	sz_encoded = ilog2(size) - 12;
+
+	hdbss_pg = alloc_pages(GFP_KERNEL_ACCOUNT, buddy_order);
 	if (!hdbss_pg)
 		return -ENOMEM;
 
 	vcpu->arch.hdbss = (struct vcpu_hdbss_state) {
 		.hdbss_pg = hdbss_pg,
-		.hdbssbr_el2 = HDBSSBR_EL2(page_to_phys(hdbss_pg), PAGE_SHIFT - 12),
+		.hdbssbr_el2 = HDBSSBR_EL2(page_to_phys(hdbss_pg), sz_encoded),
 		.hdbssprod_el2 = 0,
+		.buddy_order = buddy_order,
 	};
 
 	return 0;
@@ -37,9 +46,7 @@ void kvm_arm_vcpu_free_hdbss(struct kvm_vcpu *vcpu)
 	if (!vcpu->arch.hdbss.hdbss_pg)
 		return;
 
-	__free_pages(vcpu->arch.hdbss.hdbss_pg,
-		     FIELD_GET(HDBSSBR_EL2_SZ_MASK,
-			       vcpu->arch.hdbss.hdbssbr_el2));
+	__free_pages(vcpu->arch.hdbss.hdbss_pg, vcpu->arch.hdbss.buddy_order);
 
 	vcpu->arch.hdbss.hdbss_pg = NULL;
 	vcpu->arch.hdbss.hdbssbr_el2 = 0;
@@ -48,6 +55,7 @@ void kvm_arm_vcpu_free_hdbss(struct kvm_vcpu *vcpu)
 void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu)
 {
 	int idx, curr_idx;
+	u32 entries;
 	u64 *hdbss_buf;
 	struct kvm *kvm = vcpu->kvm;
 	int srcu_idx;
@@ -65,8 +73,11 @@ void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu)
 	if (!hdbss_buf)
 		return;
 
+	entries = (vcpu->kvm->arch.hdbss_buffer_size ?: KVM_ARM_HDBSS_DEFAULT_SIZE) /
+		  sizeof(u64);
+
 	srcu_idx = srcu_read_lock(&kvm->srcu);
-	for (idx = 0; idx < curr_idx; idx++) {
+	for (idx = 0; idx < min_t(u32, curr_idx, entries); idx++) {
 		u64 gpa;
 
 		gpa = hdbss_buf[idx];
diff --git a/include/uapi/linux/kvm.h b/include/uapi/linux/kvm.h
index 419011097fa8..56d1ee32059c 100644
--- a/include/uapi/linux/kvm.h
+++ b/include/uapi/linux/kvm.h
@@ -997,6 +997,7 @@ struct kvm_enable_cap {
 #define KVM_CAP_S390_KEYOP 247
 #define KVM_CAP_S390_VSIE_ESAMODE 248
 #define KVM_CAP_S390_HPAGE_2G 249
+#define KVM_CAP_ARM_HDBSS_BUFFER_SIZE 251
 
 struct kvm_irq_routing_irqchip {
 	__u32 irqchip;
-- 
2.43.0

