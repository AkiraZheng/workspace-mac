From db21f07bc10a239a4526b33ec9aa4b061d88d137 Mon Sep 17 00:00:00 2001
From: Tian Zheng <zhengtian10@huawei.com>
Date: Fri, 4 Sep 2026 13:53:38 +0800
Subject: [PATCH v5 02/10] KVM: arm64: Set DBM unconditionally on writable
 stage-2 PTEs
To: virt@openeuler.org

FEAT_HAFDBS (Armv8.1) allows hardware to update the dirty state of
stage-2 descriptors: with VTCR_EL2.HD=1, a descriptor with DBM=1 and
S2AP[1]=0 is writable-clean, and a write to it is performed by
hardware, which promotes the descriptor to writable-dirty without a
Permission fault. Armv9.5's HDBSS builds on this by recording the
promoted IPAs into a buffer, which the rest of this series drains to
track dirty pages for live migration without write-protect faults.

Adopt the three-state dirty state model in the stage-2 page table
code:

  State           DBM  S2AP[1]  Write behavior
  --------------  ----  -------  ------------------------------
  Non-writable     0      0     Permission fault
  Writable-clean   1      0     Hardware-managed WC -> WD
  Writable-dirty   1      1     No fault

Set DBM alongside S2AP[1] in stage2_set_prot_attr() and
kvm_pgtable_stage2_relax_perms(), so that every path installing or
relaxing write permissions produces hardware-trackable descriptors.
DBM is inert when VTCR_EL2.HD=0, as permission checking then follows
S2AP alone, so VMs not using HDBSS see no change in behavior.
Mappings outside dirty-logging memslots are covered later in the
series: their HDBSS entries are filtered when the buffer is drained.

Write-protect keeps clearing S2AP[1] everywhere, but
stage2_attr_walker() now also strips DBM from block entries: a
writable-clean block takes no write fault and would therefore never
be split into pages, while dirty tracking - including HDBSS entries,
which record IPAs aligned to the updated descriptor's size - is
page-granular. Level-3 entries keep DBM and remain writable-clean,
so hardware dirty tracking is re-armed after write-protect.

Co-developed-by: Eillon <yezhenyu2@huawei.com>
Signed-off-by: Eillon <yezhenyu2@huawei.com>
Signed-off-by: Tian Zheng <zhengtian10@huawei.com>
---
 arch/arm64/include/asm/kvm_pgtable.h |  2 ++
 arch/arm64/kvm/hyp/pgtable.c         | 27 +++++++++++++++++++++++++--
 2 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/include/asm/kvm_pgtable.h b/arch/arm64/include/asm/kvm_pgtable.h
index 41a8687938eb..6d751f23b23a 100644
--- a/arch/arm64/include/asm/kvm_pgtable.h
+++ b/arch/arm64/include/asm/kvm_pgtable.h
@@ -93,6 +93,8 @@ typedef u64 kvm_pte_t;
 
 #define KVM_PTE_LEAF_ATTR_HI_S2_XN	GENMASK(54, 53)
 
+#define KVM_PTE_LEAF_ATTR_HI_S2_DBM	BIT(51)
+
 #define KVM_PTE_LEAF_ATTR_HI_S1_GP	BIT(50)
 
 #define KVM_PTE_LEAF_ATTR_S2_PERMS	(KVM_PTE_LEAF_ATTR_LO_S2_S2AP_R | \
diff --git a/arch/arm64/kvm/hyp/pgtable.c b/arch/arm64/kvm/hyp/pgtable.c
index b74dd5ce1efd..a1acc052febd 100644
--- a/arch/arm64/kvm/hyp/pgtable.c
+++ b/arch/arm64/kvm/hyp/pgtable.c
@@ -731,9 +731,18 @@ static int stage2_set_prot_attr(struct kvm_pgtable *pgt, enum kvm_pgtable_prot p
 	if (prot & KVM_PGTABLE_PROT_R)
 		attr |= KVM_PTE_LEAF_ATTR_LO_S2_S2AP_R;
 
-	if (prot & KVM_PGTABLE_PROT_W)
+	if (prot & KVM_PGTABLE_PROT_W) {
 		attr |= KVM_PTE_LEAF_ATTR_LO_S2_S2AP_W;
 
+		/*
+		 * Set DBM alongside S2AP[1]: the descriptor becomes a
+		 * candidate for hardware-managed writable-clean to
+		 * writable-dirty transitions when VTCR_EL2.HD=1, and
+		 * DBM is inert otherwise.
+		 */
+		attr |= KVM_PTE_LEAF_ATTR_HI_S2_DBM;
+	}
+
 	if (!kvm_lpa2_is_enabled())
 		attr |= FIELD_PREP(KVM_PTE_LEAF_ATTR_LO_S2_SH, sh);
 
@@ -1234,6 +1243,17 @@ static int stage2_attr_walker(const struct kvm_pgtable_visit_ctx *ctx,
 	pte &= ~data->attr_clr;
 	pte |= data->attr_set;
 
+	/*
+	 * Strip DBM from block entries during write-protect: a
+	 * writable-clean block takes no write fault - hardware promotes
+	 * it to writable-dirty instead - so it would never be split
+	 * into pages, and dirty tracking is page-granular. Level-3
+	 * entries keep DBM, staying writable-clean to re-arm hardware
+	 * dirty tracking on the next write.
+	 */
+	if (ctx->level < KVM_PGTABLE_LAST_LEVEL)
+		pte &= ~KVM_PTE_LEAF_ATTR_HI_S2_DBM;
+
 	/*
 	 * We may race with the CPU trying to set the access flag here,
 	 * but worst-case the access flag update gets lost and will be
@@ -1367,8 +1387,11 @@ int kvm_pgtable_stage2_relax_perms(struct kvm_pgtable *pgt, u64 addr,
 	if (prot & KVM_PGTABLE_PROT_R)
 		set |= KVM_PTE_LEAF_ATTR_LO_S2_S2AP_R;
 
-	if (prot & KVM_PGTABLE_PROT_W)
+	if (prot & KVM_PGTABLE_PROT_W) {
 		set |= KVM_PTE_LEAF_ATTR_LO_S2_S2AP_W;
+		/* Writable implies DBM, see stage2_set_prot_attr(). */
+		set |= KVM_PTE_LEAF_ATTR_HI_S2_DBM;
+	}
 
 	if (prot & KVM_PGTABLE_PROT_X) {
 		ret = stage2_set_xn_attr(prot, &xn);
-- 
