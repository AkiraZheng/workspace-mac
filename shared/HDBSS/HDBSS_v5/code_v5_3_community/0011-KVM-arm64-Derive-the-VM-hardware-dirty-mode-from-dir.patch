+++ b/arch/arm64/kvm/hyp/pgtable.c
@@ -1191,9 +1191,9 @@ static int stage2_unmap_walker(const struct kvm_pgtable_visit_ctx *ctx,
 		 * Harvest the dirty state into the host folio account
