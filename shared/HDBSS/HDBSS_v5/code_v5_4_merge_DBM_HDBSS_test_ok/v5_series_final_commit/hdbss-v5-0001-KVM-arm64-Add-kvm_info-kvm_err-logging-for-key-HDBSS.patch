From 0b0553e1a8ffbeff366c862fd59afdb10e2acb9d Mon Sep 17 00:00:00 2001
From: Tian Zheng <zhengtian10@huawei.com>
Date: Fri, 18 Sep 2026 18:21:41 +0800
Subject: [PATCH] KVM: arm64: Add kvm_info/kvm_err logging for key HDBSS

---
 arch/arm64/kvm/arm.c       |  5 +++++
 arch/arm64/kvm/dirty_bit.c | 13 ++++++++++++-
 arch/arm64/kvm/mmu.c       |  4 ++++
 3 files changed, 21 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index c7681b828e80..ead407e4b23d 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -224,6 +224,8 @@ int kvm_vm_ioctl_enable_cap(struct kvm *kvm,
 			r = -EBUSY;
 		} else {
 			kvm->arch.hdbss_buffer_size = size;
+			kvm_info("HDBSS buffer size set by userspace to %llu bytes\n",
+				 size);
 			r = 0;
 		}
 		mutex_unlock(&kvm->lock);
@@ -247,6 +249,9 @@ void kvm_arch_dirty_ring_size_updated(struct kvm *kvm)
 		return;
 
 	kvm->arch.hdbss_buffer_size = KVM_ARM_HDBSS_DEFAULT_SIZE;
+
+	kvm_info("HDBSS buffer size auto-configured to %lu bytes for dirty-ring mode\n",
+		 KVM_ARM_HDBSS_DEFAULT_SIZE);
 }
 
 /**
diff --git a/arch/arm64/kvm/dirty_bit.c b/arch/arm64/kvm/dirty_bit.c
index 893a8c4248bc..a1ec68616a19 100644
--- a/arch/arm64/kvm/dirty_bit.c
+++ b/arch/arm64/kvm/dirty_bit.c
@@ -31,8 +31,11 @@ int kvm_arm_vcpu_alloc_hdbss(struct kvm_vcpu *vcpu)
 	sz_encoded = ilog2(size) - 12;
 
 	hdbss_pg = alloc_pages(GFP_KERNEL_ACCOUNT | __GFP_ZERO, buddy_order);
-	if (!hdbss_pg)
+	if (!hdbss_pg) {
+		kvm_err("VCPU%u HDBSS buffer allocation failed (order=%u)\n",
+			vcpu->vcpu_id, buddy_order);
 		return -ENOMEM;
+	}
 
 	vcpu->arch.hdbss = (struct vcpu_hdbss_state) {
 		.hdbss_pg = hdbss_pg,
@@ -41,6 +44,9 @@ int kvm_arm_vcpu_alloc_hdbss(struct kvm_vcpu *vcpu)
 		.buddy_order = buddy_order,
 	};
 
+	kvm_info("VCPU%u HDBSS buffer allocated (size=%u bytes, order=%u)\n",
+		 vcpu->vcpu_id, size, buddy_order);
+
 	return 0;
 }
 
@@ -49,6 +55,11 @@ void kvm_arm_vcpu_free_hdbss(struct kvm_vcpu *vcpu)
 	if (!vcpu->arch.hdbss.hdbss_pg)
 		return;
 
+	kvm_info("VCPU%u HDBSS buffer freed (size=%lu bytes, order=%u)\n",
+		 vcpu->vcpu_id,
+		 PAGE_SIZE << vcpu->arch.hdbss.buddy_order,
+		 vcpu->arch.hdbss.buddy_order);
+
 	__free_pages(vcpu->arch.hdbss.hdbss_pg, vcpu->arch.hdbss.buddy_order);
 
 	vcpu->arch.hdbss.hdbss_pg = NULL;
diff --git a/arch/arm64/kvm/mmu.c b/arch/arm64/kvm/mmu.c
index e298ffa72d52..2c36a5579d61 100644
--- a/arch/arm64/kvm/mmu.c
+++ b/arch/arm64/kvm/mmu.c
@@ -2646,6 +2646,10 @@ void kvm_arch_update_hw_dirty_mode(struct kvm *kvm)
 	if (cur == target)
 		return;
 
+	if (target & VTCR_EL2_HDBSS)
+		kvm_info("HDBSS enabled (buffer_size=%u bytes)\n",
+			 kvm_hdbss_buffer_size(kvm));
+
 	kvm->arch.mmu.vtcr = (kvm->arch.mmu.vtcr &
 			      ~(VTCR_EL2_HD | VTCR_EL2_HA | VTCR_EL2_HDBSS)) |
 			     target;
-- 
2.43.0

