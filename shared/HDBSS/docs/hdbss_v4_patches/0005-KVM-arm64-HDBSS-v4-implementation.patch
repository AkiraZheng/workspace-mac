diff --git a/arch/arm64/kvm/virtcca_cvm.c b/arch/arm64/kvm/virtcca_cvm.c
index 44283d2284d7..a0646d27221e 100644
--- a/arch/arm64/kvm/virtcca_cvm.c
+++ b/arch/arm64/kvm/virtcca_cvm.c
@@ -15,6 +15,7 @@
 #include <asm/kvm_mmu.h>
 #include <asm/virtcca_coda.h>
 #include <asm/kvm_tmm.h>
+#include <asm/kvm_dirty_bit.h>
 #include <asm/stage2_pgtable.h>
 #include <asm/virtcca_cvm_host.h>
 #include <asm/virtcca_coda.h>
@@ -848,6 +849,16 @@ static int kvm_populate_ipa_cvm_range(struct kvm *kvm,
 		if (cvm->mig_state->mig_src == VIRTCCA_MIG_DST) {
 			cvm->mig_state->mig_src = VIRTCCA_MIG_SRC;
 			kvm_info("the ipa range is populated before migraion\n");
+
+			/*
+			 * Auto-enable HDBSS for destination VM during migration.
+			 * Use default order (HDBSS_MAX_SIZE = 9 = 2MB buffer per vcpu).
+			 * This is called during memory population which is part of
+			 * migration initialization.
+			 */
+			if (system_supports_hdbss())
+				kvm_arm_enable_hdbss_internal(kvm, HDBSS_MAX_SIZE);
+
 			return 0;
 		}
 	}
@@ -2646,6 +2657,13 @@ static int virtcca_mig_import_end(struct kvm *kvm)
 	cvm->swiotlb_start = 0;
 	cvm->swiotlb_end = 0;
 
+	/*
+	 * Auto-disable HDBSS when migration completes (import_end).
+	 * This is called after the migration data has been imported.
+	 */
+	if (kvm->arch.enable_hdbss)
+		kvm_arm_disable_hdbss_internal(kvm);
+
 	WRITE_ONCE(cvm->state, CVM_STATE_ACTIVE);
 
 	return 0;
@@ -3505,6 +3523,12 @@ static int virtcca_mig_export_abort(struct kvm *kvm)
 	cvm->swiotlb_start = 0;
 	cvm->swiotlb_end = 0;
 
+	/*
+	 * Auto-disable HDBSS when migration aborts.
+	 */
+	if (kvm->arch.enable_hdbss)
+		kvm_arm_disable_hdbss_internal(kvm);
+
 	return ret;
 }
 
