diff --git a/arch/arm64/kvm/hyp/pgtable.c b/arch/arm64/kvm/hyp/pgtable.c
index a8646214e2fc..68fd47a6f111 100644
--- a/arch/arm64/kvm/hyp/pgtable.c
+++ b/arch/arm64/kvm/hyp/pgtable.c
@@ -729,6 +729,8 @@ enum kvm_pgtable_prot kvm_pgtable_stage2_pte_prot(kvm_pte_t pte)
 		prot |= KVM_PGTABLE_PROT_W;
 	if (!(pte & KVM_PTE_LEAF_ATTR_HI_S2_XN))
 		prot |= KVM_PGTABLE_PROT_X;
+	if (pte & KVM_PTE_LEAF_ATTR_HI_S2_DBM)
+		prot |= KVM_PGTABLE_PROT_DBM;
 
 	return prot;
 }
@@ -738,6 +740,9 @@ static bool stage2_pte_needs_update(kvm_pte_t old, kvm_pte_t new)
 	if (!kvm_pte_valid(old) || !kvm_pte_valid(new))
 		return true;
 
+	if ((old ^ new) & KVM_PTE_LEAF_ATTR_HI_S2_DBM)
+		return true;
+
 	return ((old ^ new) & (~KVM_PTE_LEAF_ATTR_S2_PERMS));
 }
 
diff --git a/arch/arm64/kvm/mmu.c b/arch/arm64/kvm/mmu.c
index 4daa11ad4dd4..18ef806c8dc3 100644
