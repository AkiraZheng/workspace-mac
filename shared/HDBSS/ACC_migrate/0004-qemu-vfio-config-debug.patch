From 4898ae9f3e5011ad92b11cf27b903a56dd4281c6 Mon Sep 17 00:00:00 2001
From: Super User <root@localhost.localdomain>
Date: Sat, 16 May 2026 10:18:01 +0800
Subject: [PATCH] vfio/pci: Add debug logging for config migration

Add VFIO_DBG prefix debug for config[0x4a] tracking.

Signed-off-by: QEMU VFIO Team <vfio@qemu.org>
---
 hw/vfio/pci.c | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/hw/vfio/pci.c b/hw/vfio/pci.c
index b2a07f6bb4..0b8469e490 100644
--- a/hw/vfio/pci.c
+++ b/hw/vfio/pci.c
@@ -1388,16 +1388,27 @@ uint32_t vfio_pci_read_config(PCIDevice *pdev, uint32_t addr, int len)
     VFIODevice *vbasedev = &vdev->vbasedev;
     uint32_t emu_bits = 0, emu_val = 0, phys_val = 0, val;
 
+    if (addr == 0x4a) {
+        printf("VFIO_DBG: Read config[0x4a]\n");
+    }
+
     memcpy(&emu_bits, vdev->emulated_config_bits + addr, len);
     emu_bits = le32_to_cpu(emu_bits);
 
     if (emu_bits) {
         emu_val = pci_default_read_config(pdev, addr, len);
+        if (addr == 0x4a) {
+            printf("VFIO_DBG: emu_bits=0x%x emu_val=0x%x\n", emu_bits, emu_val);
+        }
     }
 
     if (~emu_bits & (0xffffffffU >> (32 - len * 8))) {
         ssize_t ret;
 
+        if (addr == 0x4a) {
+            printf("VFIO_DBG: Read hw config[0x4a]\n");
+        }
+
         ret = vfio_pci_config_space_read(vdev, addr, len, &phys_val);
         if (ret != len) {
             error_report("%s(%s, 0x%x, 0x%x) failed: %s",
@@ -1406,10 +1417,17 @@ uint32_t vfio_pci_read_config(PCIDevice *pdev, uint32_t addr, int len)
             return -1;
         }
         phys_val = le32_to_cpu(phys_val);
+        if (addr == 0x4a) {
+            printf("VFIO_DBG: phys_val=0x%x\n", phys_val);
+        }
     }
 
     val = (emu_val & emu_bits) | (phys_val & ~emu_bits);
 
+    if (addr == 0x4a) {
+        printf("VFIO_DBG: Final val=0x%x\n", val);
+    }
+
     trace_vfio_pci_read_config(vdev->vbasedev.name, addr, len, val);
 
     return val;
@@ -2877,6 +2895,9 @@ static const VMStateDescription vmstate_vfio_pci_config = {
 static int vfio_pci_save_config(VFIODevice *vbasedev, QEMUFile *f, Error **errp)
 {
     VFIOPCIDevice *vdev = container_of(vbasedev, VFIOPCIDevice, vbasedev);
+    PCIDevice *pdev = PCI_DEVICE(vdev);
+
+    printf("VFIO_DBG: Save config[0x4a]=0x%x\n", pdev->config[0x4a]);
 
     return vmstate_save_state(f, &vmstate_vfio_pci_config, vdev, NULL,
                               errp);
@@ -2890,6 +2911,9 @@ static int vfio_pci_load_config(VFIODevice *vbasedev, QEMUFile *f)
     int bar, ret;
     Error *local_err = NULL;
 
+    printf("VFIO_DBG: Load config cur[0x4a]=0x%x cmask[0x4a]=0x%x\n",
+           pdev->config[0x4a], pdev->cmask[0x4a]);
+
     for (bar = 0; bar < PCI_ROM_SLOT; bar++) {
         old_addr[bar] = pdev->io_regions[bar].addr;
     }
@@ -2897,10 +2921,13 @@ static int vfio_pci_load_config(VFIODevice *vbasedev, QEMUFile *f)
     ret = vmstate_load_state(f, &vmstate_vfio_pci_config, vdev, 1,
                              &local_err);
     if (ret) {
+        printf("VFIO_DBG: Load failed ret=%d\n", ret);
         error_report_err(local_err);
         return ret;
     }
 
+    printf("VFIO_DBG: Load success new[0x4a]=0x%x\n", pdev->config[0x4a]);
+
     vfio_pci_write_config(pdev, PCI_COMMAND,
                           pci_get_word(pdev->config + PCI_COMMAND), 2);
 
-- 
2.43.0

