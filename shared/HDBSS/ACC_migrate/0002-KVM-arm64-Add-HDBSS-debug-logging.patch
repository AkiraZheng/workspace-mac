From 369f59dfb9d8cfd2834487237b50c7324cab8ce8 Mon Sep 17 00:00:00 2001
From: Super User <root@localhost.localdomain>
Date: Sat, 16 May 2026 09:40:12 +0800
Subject: [PATCH] KVM: arm64: Add HDBSS debug logging for VFIO MMIO interaction

This patch adds comprehensive debug logging to track HDBSS behavior
with VFIO/MMIO regions, helping identify DBM incorrectly applied to
device memory.

Debug points added:
- mmu.c: MMIO fault detection and DBM decision logic
- handle_exit.c: HDBSS buffer flush entries (check for MMIO GPAs)
- arm.c: HDBSS enable/disable timing and state tracking

All debug messages use pr_info_ratelimited() to avoid log spam.

Usage:
1. Enable kernel logging: echo 8 > /proc/sys/kernel/printk
2. Run VFIO migration tests
3. Collect logs: dmesg | grep HDBSS_DEBUG
4. Analyze MMIO faults and DBM decisions

Key debug messages:
- HDBSS_DEBUG_MMIO_FAULT: Device MMIO fault detected
- HDBSS_DEBUG_DBM_DECISION: DBM setting logic conditions
- HDBSS_DEBUG_DBM_RESULT/SKIP: Whether DBM was added or skipped
- HDBSS_DEBUG_FLUSH_ENTRY: Dirty GPAs (check for MMIO addresses)

Signed-off-by: HDBSS Team <hdbss@example.com>
---
 arch/arm64/kvm/arm.c         | 14 ++++++++++++++
 arch/arm64/kvm/handle_exit.c |  9 +++++++++
 arch/arm64/kvm/mmu.c         | 23 ++++++++++++++++++++++-
 3 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index 0e4cad7532df..bfa35ca08374 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -149,10 +149,16 @@ static void kvm_clear_hdbss(struct kvm *kvm)
 	struct kvm_vcpu *vcpu;
 	struct page *hdbss_pg;
 
+	/* DEBUG: Track HDBSS disable timing */
+	pr_info("HDBSS_DEBUG_DISABLE: Clearing HDBSS, enable_hdbss=%d vtcr=0x%lx\n",
+		kvm->enable_hdbss, kvm->arch.vtcr);
+
 	kvm->arch.vtcr &= ~(VTCR_EL2_HD | VTCR_EL2_HDBSS);
 
 	kvm_for_each_vcpu(i, vcpu, kvm) {
 		/* Kick vcpus to flush hdbss buffer. */
+		pr_info("HDBSS_DEBUG_DISABLE_VCPU: vcpu %lu br_el2=0x%llx\n",
+			i, vcpu->arch.hdbss.br_el2);
 		kvm_vcpu_kick(vcpu);
 
 		hdbss_pg = phys_to_page(HDBSSBR_BADDR(vcpu->arch.hdbss.br_el2));
@@ -164,6 +170,7 @@ static void kvm_clear_hdbss(struct kvm *kvm)
 	}
 
 	kvm->enable_hdbss = false;
+	pr_info("HDBSS_DEBUG_DISABLE_DONE: HDBSS disabled\n");
 }
 
 static int kvm_cap_arm_enable_hdbss(struct kvm *kvm,
@@ -190,6 +197,9 @@ static int kvm_cap_arm_enable_hdbss(struct kvm *kvm,
 	}
 
 	/* Enable the HDBSS feature if size > 0, otherwise disable it. */
+	pr_info("HDBSS_DEBUG_ENABLE_REQ: size=%d (order) enable_hdbss=%d\n",
+		size, kvm->enable_hdbss);
+
 	if (size) {
 		kvm->enable_hdbss = true;
 		kvm->arch.vtcr |= VTCR_EL2_HD | VTCR_EL2_HDBSS;
@@ -205,6 +215,9 @@ static int kvm_cap_arm_enable_hdbss(struct kvm *kvm,
 			vcpu->arch.hdbss.br_el2 = HDBSSBR_EL2(page_to_phys(hdbss_pg), size);
 			vcpu->arch.hdbss.prod_el2 = 0;
 
+			pr_info("HDBSS_DEBUG_ENABLE_VCPU: vcpu %lu br_el2=0x%llx size=%d\n",
+				i, vcpu->arch.hdbss.br_el2, size);
+
 			/*
 			 * We should kick vcpus out of guest mode here to
 			 * load new vtcr value to vtcr_el2 register when
@@ -214,6 +227,7 @@ static int kvm_cap_arm_enable_hdbss(struct kvm *kvm,
 		}
 
 		kvm_info("Enable HDBSS success, HDBSS buffer size: %d\n", size);
+		pr_info("HDBSS_DEBUG_ENABLE_DONE: HDBSS enabled successfully\n");
 	} else if (kvm->enable_hdbss) {
 		kvm_clear_hdbss(kvm);
 		kvm_info("Disable HDBSS success\n");
diff --git a/arch/arm64/kvm/handle_exit.c b/arch/arm64/kvm/handle_exit.c
index 6919c3858193..0d00a473092f 100644
--- a/arch/arm64/kvm/handle_exit.c
+++ b/arch/arm64/kvm/handle_exit.c
@@ -310,6 +310,10 @@ static void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu)
 	isb();
 	curr_idx = HDBSSPROD_IDX(read_sysreg_s(SYS_HDBSSPROD_EL2));
 
+	/* DEBUG: Track HDBSS buffer flush timing */
+	pr_info_ratelimited("HDBSS_DEBUG_FLUSH_START: vcpu=%d curr_idx=%d br_el2=0x%llx\n",
+		vcpu->vcpu_idx, curr_idx, vcpu->arch.hdbss.br_el2);
+
 	/* Do nothing if HDBSS buffer is empty or br_el2 is NULL */
 	if (curr_idx == 0 || vcpu->arch.hdbss.br_el2 == 0)
 		return;
@@ -328,6 +332,9 @@ static void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu)
 			continue;
 
 		gpa = gpa & HDBSS_ENTRY_IPA_MASK;
+		/* DEBUG: Track each dirty GPA (critical for MMIO bug) */
+		pr_info_ratelimited("HDBSS_DEBUG_FLUSH_ENTRY: "
+			"idx=%d gpa=0x%llx (check if MMIO addr!)\n", idx, gpa);
 		kvm_vcpu_mark_page_dirty(vcpu, gpa >> PAGE_SHIFT);
 	}
 
@@ -335,6 +342,8 @@ static void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu)
 	write_sysreg_s(0, SYS_HDBSSPROD_EL2);
 	dsb(sy);
 	isb();
+
+	pr_info_ratelimited("HDBSS_DEBUG_FLUSH_END: flushed %d entries\n", curr_idx);
 }
 #endif
 
diff --git a/arch/arm64/kvm/mmu.c b/arch/arm64/kvm/mmu.c
index b505936a2f64..9ec25cfd48e6 100644
--- a/arch/arm64/kvm/mmu.c
+++ b/arch/arm64/kvm/mmu.c
@@ -1607,6 +1607,13 @@ static int user_mem_abort(struct kvm_vcpu *vcpu, phys_addr_t fault_ipa,
 		return -EFAULT;
 
 	if (kvm_is_device_pfn(pfn)) {
+		/*
+		 * DEBUG: Critical point for VFIO/MMIO detection
+		 * Track device memory identification for HDBSS bug analysis
+		 */
+		pr_info_ratelimited("HDBSS_DEBUG_MMIO_FAULT: Device MMIO fault! "
+			"fault_ipa=0x%llx pfn=0x%lx gfn=0x%lx writable=%d\n",
+			fault_ipa, pfn, gfn, writable);
 		/*
 		 * If the page was identified as device early by looking at
 		 * the VMA flags, vma_pagesize is already representing the
@@ -1678,9 +1685,23 @@ static int user_mem_abort(struct kvm_vcpu *vcpu, phys_addr_t fault_ipa,
 	if (writable)
 		prot |= KVM_PGTABLE_PROT_W;
 
+	/*
+	 * DEBUG: Critical DBM decision point
+	 * Track HDBSS DBM setting logic for bug analysis
+	 */
+	pr_info_ratelimited("HDBSS_DEBUG_DBM_DECISION: "
+		"fault_ipa=0x%llx device=%d enable_hdbss=%d logging_active=%d writable=%d\n",
+		fault_ipa, device, kvm->enable_hdbss, logging_active, writable);
+
 #ifdef CONFIG_ARM64_HDBSS
-	if (!device && kvm->enable_hdbss && logging_active)
+	if (!device && kvm->enable_hdbss && logging_active) {
 		prot |= KVM_PGTABLE_PROT_DBM;
+		pr_info_ratelimited("HDBSS_DEBUG_DBM_RESULT: DBM added for RAM "
+			"fault_ipa=0x%llx prot=0x%x\n", fault_ipa, prot);
+	} else if (device && kvm->enable_hdbss && logging_active) {
+		pr_info_ratelimited("HDBSS_DEBUG_DBM_SKIP: DBM NOT added for MMIO "
+			"fault_ipa=0x%llx device=%d\n", fault_ipa, device);
+	}
 #endif
 
 	if (exec_fault)
