From 6309b789b170d36bbeddb2b9ca5e2724c1a5eb1c Mon Sep 17 00:00:00 2001
From: Super User <root@localhost.localdomain>
Date: Sat, 9 May 2026 23:11:19 +0800
Subject: [PATCH 09/18] KVM: arm64: Add dirty_bit.c and dirty_bit.h for HDBSS
 code archiving

Create dedicated files for HDBSS (Hardware Dirty Bit Storage System)
support, moving related code from arm.c and mmu.c.

- arch/arm64/include/asm/kvm_dirty_bit.h: HDBSS definitions and declarations
- arch/arm64/kvm/dirty_bit.c: HDBSS implementation
- arch/arm64/kvm/Makefile: Add dirty_bit.o to build

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 arch/arm64/include/asm/kvm_dirty_bit.h |  61 +++++++++
 arch/arm64/kvm/Makefile                |   1 +
 arch/arm64/kvm/dirty_bit.c             | 172 +++++++++++++++++++++++++
 3 files changed, 234 insertions(+)
 create mode 100644 arch/arm64/include/asm/kvm_dirty_bit.h
 create mode 100644 arch/arm64/kvm/dirty_bit.c

diff --git a/arch/arm64/include/asm/kvm_dirty_bit.h b/arch/arm64/include/asm/kvm_dirty_bit.h
new file mode 100644
index 000000000000..1ebdd8015aea
--- /dev/null
+++ b/arch/arm64/include/asm/kvm_dirty_bit.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (c) 2024 Huawei Technologies Co., Ltd.
+ *
+ * Header file for HDBSS (Hardware Dirty Bit Storage System) support.
+ *
+ * This file contains the definitions and declarations for HDBSS feature
+ * support in ARM64 KVM.
+ */
+
+#ifndef _ASM_ARM64_KVM_DIRTY_BIT_H
+#define _ASM_ARM64_KVM_DIRTY_BIT_H
+
+#include <linux/types.h>
+#include <asm/sysreg.h>
+
+/* HDBSS entry valid flag */
+#define HDBSS_ENTRY_VALID	UL(0x1)
+#define HDBSS_ENTRY_IPA		GENMASK_ULL(55, 12)
+
+/* HDBSS producer index mask */
+#define HDBSSPROD_IDX(prod)	FIELD_GET(HDBSSPROD_EL2_INDEX_MASK, prod)
+
+/* HDBSS producer FSC codes */
+#define HDBSSPROD_EL2_FSC_OK			0x00
+#define HDBSSPROD_EL2_FSC_ExternalAbort		0x10
+#define HDBSSPROD_EL2_FSC_GPF			0x0f
+
+/*
+ * kvm_arm_enable_hdbss_internal - Enable HDBSS for a VM
+ * @kvm: pointer to KVM instance
+ * @order: order of the HDBSS buffer page (size = 2^order pages)
+ *
+ * Returns: 0 on success, negative error code on failure
+ */
+int kvm_arm_enable_hdbss_internal(struct kvm *kvm, u64 order);
+
+/*
+ * kvm_arm_disable_hdbss_internal - Disable HDBSS for a VM
+ * @kvm: pointer to KVM instance
+ */
+void kvm_arm_disable_hdbss_internal(struct kvm *kvm);
+
+/*
+ * kvm_flush_hdbss_buffer - Flush HDBSS buffer to dirty bitmap
+ * @vcpu: pointer to VCPU instance
+ *
+ * This function reads the HDBSS buffer and marks dirty pages
+ * in the KVM dirty bitmap.
+ */
+void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu);
+
+/*
+ * kvm_hdbss_buffer_empty - Check if HDBSS buffer is empty
+ * @vcpu: pointer to VCPU instance
+ *
+ * Returns: true if buffer is empty, false otherwise
+ */
+bool kvm_hdbss_buffer_empty(struct kvm_vcpu *vcpu);
+
+#endif /* _ASM_ARM64_KVM_DIRTY_BIT_H */
\ No newline at end of file
