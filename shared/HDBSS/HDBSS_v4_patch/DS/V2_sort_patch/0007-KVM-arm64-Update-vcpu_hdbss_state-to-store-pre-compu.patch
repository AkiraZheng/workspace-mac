From 300d9740a7d83a8e5bf1a57d2ebb992f84c58ba6 Mon Sep 17 00:00:00 2001
From: Super User <root@localhost.localdomain>
Date: Sun, 10 May 2026 04:27:23 +0800
Subject: [07/12] KVM: arm64: Update vcpu_hdbss_state to store pre-computed
 register values

Replace the size and next_index fields with pre-computed hdbssbr_el2
and hdbssprod_el2 register values. This avoids recomputing HDBSSBR_EL2
on every vcpu load and allows __load_hdbss() to write the registers
directly without extra computation.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 arch/arm64/include/asm/kvm_host.h |  6 +++---
 arch/arm64/kvm/arm.c              | 10 ++++++----
 arch/arm64/kvm/hyp/vhe/switch.c   |  8 ++------
 arch/arm64/kvm/mmu.c              |  6 ++----
 4 files changed, 13 insertions(+), 17 deletions(-)

diff --git a/arch/arm64/include/asm/kvm_host.h b/arch/arm64/include/asm/kvm_host.h
index 5223180d31f4..703241865f8a 100644
--- a/arch/arm64/include/asm/kvm_host.h
+++ b/arch/arm64/include/asm/kvm_host.h
@@ -862,9 +862,9 @@ struct vcpu_reset_state {
 };
 
 struct vcpu_hdbss_state {
-	phys_addr_t base_phys;
-	u32 size;
-	u32 next_index;
+	phys_addr_t base_phys;   /* for memory free */
+	u64 hdbssbr_el2;         /* load directly */
+	u64 hdbssprod_el2;       /* save directly */
 };
 
 struct vncr_tlb;
diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index aba3d1b278a5..ba4db15cc404 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -137,9 +137,11 @@ void kvm_arm_vcpu_free_hdbss(struct kvm_vcpu *vcpu)
 
 	hdbss_pg = phys_to_page(vcpu->arch.hdbss.base_phys);
 	if (hdbss_pg)
-		__free_pages(hdbss_pg, vcpu->arch.hdbss.size);
+		__free_pages(hdbss_pg,
+			     FIELD_GET(HDBSSBR_EL2_SZ_MASK,
+				       vcpu->arch.hdbss.hdbssbr_el2));
 
-	vcpu->arch.hdbss.size = 0;
+	vcpu->arch.hdbss.hdbssbr_el2 = 0;
 }
 
 static int kvm_cap_arm_enable_hdbss(struct kvm *kvm,
@@ -186,8 +188,8 @@ static int kvm_cap_arm_enable_hdbss(struct kvm *kvm,
 
 		vcpu->arch.hdbss = (struct vcpu_hdbss_state) {
 			.base_phys = page_to_phys(hdbss_pg),
-			.size = size,
-			.next_index = 0,
+			.hdbssbr_el2 = HDBSSBR_EL2(page_to_phys(hdbss_pg), size),
+			.hdbssprod_el2 = 0,
 		};
 	}
 
diff --git a/arch/arm64/kvm/hyp/vhe/switch.c b/arch/arm64/kvm/hyp/vhe/switch.c
index 8ad8231246f2..73dbd66870b4 100644
--- a/arch/arm64/kvm/hyp/vhe/switch.c
+++ b/arch/arm64/kvm/hyp/vhe/switch.c
@@ -216,16 +216,12 @@ static void __vcpu_put_deactivate_traps(struct kvm_vcpu *vcpu)
 static void __load_hdbss(struct kvm_vcpu *vcpu)
 {
 	struct kvm *kvm = vcpu->kvm;
-	u64 br_el2, prod_el2;
 
 	if (!kvm->arch.enable_hdbss)
 		return;
 
-	br_el2 = HDBSSBR_EL2(vcpu->arch.hdbss.base_phys, vcpu->arch.hdbss.size);
-	prod_el2 = vcpu->arch.hdbss.next_index;
-
-	write_sysreg_s(br_el2, SYS_HDBSSBR_EL2);
-	write_sysreg_s(prod_el2, SYS_HDBSSPROD_EL2);
+	write_sysreg_s(vcpu->arch.hdbss.hdbssbr_el2, SYS_HDBSSBR_EL2);
+	write_sysreg_s(vcpu->arch.hdbss.hdbssprod_el2, SYS_HDBSSPROD_EL2);
 
 	isb();
 }
diff --git a/arch/arm64/kvm/mmu.c b/arch/arm64/kvm/mmu.c
index 3a7a1d26a6d4..61f176e797ed 100644
--- a/arch/arm64/kvm/mmu.c
+++ b/arch/arm64/kvm/mmu.c
@@ -2207,7 +2207,6 @@ int kvm_handle_guest_sea(struct kvm_vcpu *vcpu)
 void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu)
 {
 	int idx, curr_idx;
-	u64 br_el2;
 	u64 *hdbss_buf;
 	struct kvm *kvm = vcpu->kvm;
 
@@ -2215,10 +2214,9 @@ void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu)
 		return;
 
 	curr_idx = HDBSSPROD_IDX(read_sysreg_s(SYS_HDBSSPROD_EL2));
-	br_el2 = HDBSSBR_EL2(vcpu->arch.hdbss.base_phys, vcpu->arch.hdbss.size);
 
 	/* Do nothing if HDBSS buffer is empty or br_el2 is NULL */
-	if (curr_idx == 0 || br_el2 == 0)
+	if (curr_idx == 0 || vcpu->arch.hdbss.hdbssbr_el2 == 0)
 		return;
 
 	hdbss_buf = page_address(phys_to_page(vcpu->arch.hdbss.base_phys));
@@ -2239,7 +2237,7 @@ void kvm_flush_hdbss_buffer(struct kvm_vcpu *vcpu)
 
 	/* reset HDBSS index */
 	write_sysreg_s(0, SYS_HDBSSPROD_EL2);
-	vcpu->arch.hdbss.next_index = 0;
+	vcpu->arch.hdbss.hdbssprod_el2 = 0;
 	isb();
 }
 
