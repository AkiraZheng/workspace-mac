From be7046c80baad441d8c958eeec898be0cde17e17 Mon Sep 17 00:00:00 2001
From: Super User <root@localhost.localdomain>
Date: Sun, 10 May 2026 04:46:17 +0800
Subject: [PATCH 11/15] KVM: arm64: Move HDBSS flush from vcpu_put_vhe to
 kvm_arch_vcpu_put

Move the HDBSS buffer flush out of the VHE-specific switch code into
the arch vcpu_put path. This keeps the VHE switch functions clean of
HDBSS logic and makes the flush trigger point more explicit in the
scheduler-driven vcpu_put flow.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 arch/arm64/kvm/arm.c            | 2 ++
 arch/arm64/kvm/hyp/vhe/switch.c | 1 -
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index 7129993ce138..08cd0486e220 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -749,6 +749,8 @@ void kvm_arch_vcpu_load(struct kvm_vcpu *vcpu, int cpu)
 
 void kvm_arch_vcpu_put(struct kvm_vcpu *vcpu)
 {
+	kvm_flush_hdbss_buffer(vcpu);
+
 	if (is_protected_kvm_enabled()) {
 		kvm_call_hyp(__vgic_v3_save_aprs, &vcpu->arch.vgic_cpu.vgic_v3);
 		kvm_call_hyp_nvhe(__pkvm_vcpu_put);
diff --git a/arch/arm64/kvm/hyp/vhe/switch.c b/arch/arm64/kvm/hyp/vhe/switch.c
index 9e8def0a091a..11145855ad3a 100644
--- a/arch/arm64/kvm/hyp/vhe/switch.c
+++ b/arch/arm64/kvm/hyp/vhe/switch.c
@@ -226,7 +226,6 @@ void kvm_vcpu_load_vhe(struct kvm_vcpu *vcpu)
 
 void kvm_vcpu_put_vhe(struct kvm_vcpu *vcpu)
 {
-	kvm_flush_hdbss_buffer(vcpu);
 	__vcpu_put_deactivate_traps(vcpu);
 	__vcpu_put_switch_sysregs(vcpu);
 
-- 
