From ebebdaca657ab0ac93c45a08f14fbab223db6070 Mon Sep 17 00:00:00 2001
From: Super User <root@localhost.localdomain>
Date: Sun, 10 May 2026 01:06:10 +0800
Subject: [PATCH 17/18] KVM: arm64: Add HDBSS disable in VM destroy path

Call kvm_arm_disable_hdbss_internal() when the VM is destroyed
to ensure HDBSS resources are properly freed and VTCR is restored.

Co-Authored-By: Claude Opus 4.7 <noreply@anthropic.com>
---
 arch/arm64/kvm/arm.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/kvm/arm.c b/arch/arm64/kvm/arm.c
index de864ff38923..acb28442e758 100644
--- a/arch/arm64/kvm/arm.c
+++ b/arch/arm64/kvm/arm.c
@@ -382,6 +382,8 @@ static void kvm_destroy_mpidr_data(struct kvm *kvm)
  */
 void kvm_arch_destroy_vm(struct kvm *kvm)
 {
+	kvm_arm_disable_hdbss_internal(kvm);
+
 	bitmap_free(kvm->arch.pmu_filter);
 	free_cpumask_var(kvm->arch.supported_cpus);
 
