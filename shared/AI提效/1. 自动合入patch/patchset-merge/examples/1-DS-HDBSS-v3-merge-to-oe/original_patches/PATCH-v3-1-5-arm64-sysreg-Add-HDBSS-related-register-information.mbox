> > +
> >  int kvm_vm_ioctl_enable_cap(struct kvm *kvm,
> >  			    struct kvm_enable_cap *cap)
> >  {
> > @@ -182,6 +263,11 @@ int kvm_vm_ioctl_enable_cap(struct kvm *kvm,
