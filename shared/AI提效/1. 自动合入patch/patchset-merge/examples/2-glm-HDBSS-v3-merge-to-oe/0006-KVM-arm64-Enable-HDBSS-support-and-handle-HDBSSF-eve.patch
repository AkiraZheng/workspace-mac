@@ -1154,6 +1154,30 @@
 #define SYS_FIELD_PREP(reg, field, val)		\
 		 FIELD_PREP(reg##_##field##_MASK, val)
 
+/*
+ * Definitions for the HDBSS feature
+ */
+#define HDBSS_MAX_SIZE		HDBSSBR_EL2_SZ_2MB
+
+#define HDBSSBR_EL2_SZ_MASK		GENMASK(3, 0)
+#define HDBSSBR_EL2_SZ_4KB		0
+#define HDBSSBR_EL2_SZ_8KB		1
+#define HDBSSBR_EL2_SZ_16KB		2
+#define HDBSSBR_EL2_SZ_32KB		3
+#define HDBSSBR_EL2_SZ_64KB		4
+#define HDBSSBR_EL2_SZ_128KB		5
+#define HDBSSBR_EL2_SZ_256KB		6
+#define HDBSSBR_EL2_SZ_512KB		7
+#define HDBSSBR_EL2_SZ_1MB		8
+#define HDBSSBR_EL2_SZ_2MB		9
+
+#define HDBSSPROD_EL2_INDEX_MASK	GENMASK(18, 0)
+
+#define HDBSSBR_EL2(baddr, sz)	(((baddr) & GENMASK(55, 12 + sz)) | \
+				 FIELD_PREP(HDBSSBR_EL2_SZ_MASK, sz))
+
+#define HDBSSPROD_IDX(prod)	FIELD_GET(HDBSSPROD_EL2_INDEX_MASK, prod)
