{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "autofix-upstream/triage.schema.json",
  "title": "检视意见台账 (triage.json,harness 唯一写者;LLM 产物经 triage-merge 校验并入)",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/triage_item"}
    }
  },
  "$defs": {
    "triage_item": {
      "type": "object",
      "required": ["id", "round", "status", "source", "target_patch"],
      "properties": {
        "id": {"type": "string", "pattern": "^r[0-9]+-[0-9]{3}$"},
        "round": {"type": "integer", "minimum": 0},
        "status": {"enum": ["pending", "analyzed", "fixed", "invalid", "wontfix", "deferred", "record_only"]},
        "verdict": {"enum": ["valid", "invalid", "partial", "question", "record_only", null]},
        "fix_type": {"enum": ["code", "cover_note", "none", null]},
        "source": {
          "type": "object",
          "required": ["message_id", "from_email", "sender_class", "eml_path"],
          "properties": {
            "message_id": {"type": "string"},
            "in_reply_to": {"type": ["string", "null"]},
            "from_name": {"type": "string"},
            "from_email": {"type": "string"},
            "date": {"type": "string"},
            "subject": {"type": "string"},
            "eml_path": {"type": "string", "description": "相对系列工作区的路径"},
            "sender_class": {"enum": ["human", "ai_reviewer", "bot", "author"]},
            "sender_rule": {"type": "string"}
          }
        },
        "target_patch": {
          "type": "object",
          "properties": {
            "seq": {"type": ["integer", "null"], "description": "0=系列级,-1=无法确定"},
            "subject": {"type": ["string", "null"]}
          }
        },
        "summary_zh": {"type": ["string", "null"]},
        "quotes": {"type": ["array", "null"], "items": {"type": "string"}},
        "analysis_zh": {"type": ["string", "null"]},
        "fix_approach_zh": {"type": ["string", "null"]},
        "ai_scrutiny": {
          "type": "object",
          "properties": {
            "suspected_llm": {"type": "boolean"},
            "confidence": {"enum": ["high", "medium", "low", null]},
            "note": {"type": ["string", "null"]}
          }
        },
        "fix_commit": {"type": ["string", "null"]},
        "message_change_needed": {"type": "boolean"},
        "message_change_text": {"type": ["string", "null"]},
        "changelog_en": {"type": ["string", "null"]},
        "decided_by": {"enum": ["llm", "human", null]},
        "decided_at": {"type": ["string", "null"]}
      }
    },
    "triage_item_llm": {
      "type": "object",
      "description": "LLM 允许写入 reviews/round-N/item-*.json 的字段子集",
      "required": ["id", "verdict", "fix_type", "summary_zh"],
      "properties": {
        "id": {"type": "string", "pattern": "^r[0-9]+-[0-9]{3}$"},
        "verdict": {"enum": ["valid", "invalid", "partial", "question", "record_only"]},
        "fix_type": {"enum": ["code", "cover_note", "none"]},
        "summary_zh": {"type": "string", "minLength": 1},
        "quotes": {"type": "array", "items": {"type": "string"}},
        "analysis_zh": {"type": "string"},
        "fix_approach_zh": {"type": ["string", "null"]},
        "ai_scrutiny": {
          "type": "object",
          "properties": {
            "suspected_llm": {"type": "boolean"},
            "confidence": {"enum": ["high", "medium", "low"]},
            "note": {"type": ["string", "null"]}
          }
        },
        "message_change_needed": {"type": "boolean"},
        "message_change_text": {"type": ["string", "null"]},
        "changelog_en": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  }
}
