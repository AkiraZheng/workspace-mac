+
+/*
+ * Helper to build CLI with common args and test-specific args
+ */
+static char *make_cli(const char *base_cli, const char *test_cli)
+{
+    if (test_cli && test_cli[0]) {
+        return g_strdup_printf("%s %s", base_cli, test_cli);
+    }
+    return g_strdup(base_cli);
+}
+
+/*
+ * Test: Valid command - single domain with full broadcast
+ * Expected: QEMU starts successfully
+ */
+static void test_tlbidomain_valid_single(const void *data)
+{
+    QTestState *qts;
+    g_autofree char *cli = NULL;
+    const char *base_cli = data;
+
+    cli = make_cli(base_cli, "-tlbidomain domain_id=0,cpu=0-7");
+    qts = qtest_init(cli);
+
+    /* If we get here without crashing, the test passes */
+    /* We could query ACPI tables here if we had a way */
+
+    qtest_quit(qts);
+}
+
+/*
+ * Test: Valid command - multiple domains
+ * Expected: QEMU starts successfully
+ */
+static void test_tlbidomain_valid_multiple(const void *data)
+{
+    QTestState *qts;
+    g_autofree char *cli = NULL;
+    const char *base_cli = data;
+
+    cli = make_cli(base_cli, "-tlbidomain domain_id=0,cpu=0-15 "
+                               "-tlbidomain domain_id=1,cpu=0-7");
+    qts = qtest_init(cli);
+
+    qtest_quit(qts);
+}
+
+/*
+ * Test: Valid command - with level parameter
+ * Expected: QEMU starts successfully
+ */
