+在 virt-acpi-build.c 中（build_iort() 函数之后）添加：
+
+```c
+/*
+ * Build TLBI (TLB Invalidate Domain) Table
+ * Conforms to ACPI Specification Version 6.next
+ * Table 5.W - Translation Lookaside Buffer Invalidate Domain Table
+ */
+static void build_tlbi(GArray *table_data, BIOSLinker *linker,
+                       VirtMachineState *vms)
+{
+    int i, j;
+    MachineState *ms = MACHINE(vms);
+    AcpiTable table = { .sig = "TLBI", .rev = 1, .oem_id = vms->oem_id,
+                        .oem_table_id = vms->oem_table_id };
+    uint32_t component_offset;
+    uint32_t num_components = 0;
+    GArray *domain_arrays = g_array_new(false, true, sizeof(uint32_t));
+
+    /* 计算组件数量（只计算有 vCPU 的 domain 的 vCPU 数量） */
+    for (i = 0; i < vms->num_tlb_domains; i++) {
+        if (vms->tlbidomains[i].present) {
+            num_components += (vms->tlbidomains[i].cpu_end -
+                              vms->tlbidomains[i].cpu_start + 1);
+        }
+    }
+
+    acpi_table_begin(&table, table_data);
+
+    /* Number of components */
+    build_append_int_noprefix(table_data, num_components, 4);
+
+    /* Offset to component list (after header) */
+    build_append_int_noprefix(table_data, 40, 4);
+
+    /* Component list - 为每个 vCPU 创建 component sub-table */
+    for (i = 0; i < ms->smp.cpus; i++) {
+        uint32_t domain_array_offset;
+        uint32_t num_domains = 0;
+        GArray *vcpu_domains = g_array_new(false, true, sizeof(uint32_t));
+
+        /* 找出该 vCPU 属于哪些 domain */
+        for (j = 0; j < vms->num_tlb_domains; j++) {
+            TlbDomainInfo *dom = &vms->tlbidomains[j];
+            if (dom->present && i >= dom->cpu_start && i <= dom->cpu_end) {
+                g_array_append_val(vcpu_domains, dom->domain_id);
+                num_domains++;
+            }
+        }
+
+        /* 只有属于至少一个 domain 的 vCPU 才添加到表 */
+        if (num_domains == 0) {
+            g_array_free(vcpu_domains, true);
+            continue;
+        }
+
+        /* Type: 1 = PE */
+        build_append_int_noprefix(table_data, 1, 2);
+        /* Reserved */
+        build_append_int_noprefix(table_data, 0, 2);
+
+        /* Length: 20 + 4*num_domains (header + domain array) */
+        uint32_t length = 20 + 4 * num_domains;
+        build_append_int_noprefix(table_data, length, 4);
+
+        /* Identifier: ACPI Processor UID = vCPU index */
+        build_append_int_noprefix(table_data, i, 4);
+
+        /* Number of Domains */
+        build_append_int_noprefix(table_data, num_domains, 4);
+
+        /* Domain array offset: from start of TLBI table */
+        domain_array_offset = table_data->len - table.table_offset;
+        build_append_int_noprefix(table_data, domain_array_offset, 4);
+
+        /* Domain array */
+        for (j = 0; j < num_domains; j++) {
+            uint32_t domain_id = g_array_index(vcpu_domains, uint32_t, j);
+            build_append_int_noprefix(table_data, domain_id, 4);
+        }
+
+        g_array_free(vcpu_domains, true);
+    }
+
+    acpi_table_end(linker, &table);
+    g_array_free(domain_arrays, true);
+}
+```
