 }
 
+/*
+ * Build TLBI (TLB Invalidate Domain) Table
+ * Conforms to ACPI Specification Version 6.next
+ * Table 5.W - Translation Lookaside Buffer Invalidate Domain Table
+ */
+static void
+build_tlbi(GArray *table_data, BIOSLinker *linker, VirtMachineState *vms)
+{
+    int i, j;
+    MachineState *ms = MACHINE(vms);
+    AcpiTable table = { .sig = "TLBI", .rev = 1, .oem_id = vms->oem_id,
+                        .oem_table_id = vms->oem_table_id };
+    uint32_t num_components = 0;
+
+    /*
+     * Count vCPUs that belong to at least one domain.
+     * Each vCPU will be a component in the TLBI table.
+     */
+    for (i = 0; i < ms->smp.cpus; i++) {
+        for (j = 0; j < vms->num_tlb_domains; j++) {
+            TlbDomainInfo *dom = &vms->tlbidomains[j];
+            if (dom->present && i >= dom->cpu_start && i <= dom->cpu_end) {
+                num_components++;
+                break; /* Count vCPU only once */
+            }
+        }
+    }
+
+    acpi_table_begin(&table, table_data);
+
+    /* Number of components */
+    build_append_int_noprefix(table_data, num_components, 4);
+
+    /* Component list offset (after header) */
+    build_append_int_noprefix(table_data, 40, 4);
+
+    /*
+     * Component list - create component sub-table for each vCPU
+     */
+    for (i = 0; i < ms->smp.cpus; i++) {
+        uint32_t num_domains = 0;
+        uint32_t domain_ids[128]; /* MAX_TLB_DOMAINS */
+        uint32_t length;
+
+        /* Find all domains this vCPU belongs to */
+        for (j = 0; j < vms->num_tlb_domains; j++) {
+            TlbDomainInfo *dom = &vms->tlbidomains[j];
+            if (dom->present && i >= dom->cpu_start && i <= dom->cpu_end) {
+                domain_ids[num_domains++] = dom->domain_id;
+            }
+        }
+
+        /* Skip vCPUs not belonging to any domain */
+        if (num_domains == 0) {
+            continue;
+        }
+
+        /* Type: 1 = PE */
+        build_append_int_noprefix(table_data, 1, 2);
+        /* Reserved */
+        build_append_int_noprefix(table_data, 0, 2);
+        /* Length: 20 + 4*num_domains */
+        length = 20 + 4 * num_domains;
+        build_append_int_noprefix(table_data, length, 4);
+        /* Identifier: ACPI Processor UID = vCPU index */
+        build_append_int_noprefix(table_data, i, 4);
+        /* Number of Domains */
+        build_append_int_noprefix(table_data, num_domains, 4);
+        /* Domain array offset from start of this component sub-table */
+        build_append_int_noprefix(table_data, 16, 4);
+        /* Domain array */
+        for (j = 0; j < num_domains; j++) {
+            build_append_int_noprefix(table_data, domain_ids[j], 4);
+        }
+    }
+
+    acpi_table_end(linker, &table);
+}
+
+/*
+ * Build TLBH (TLB Invalidate Domain Hierarchy Level) Table
+ * Conforms to ACPI Specification Version 6.next
+ * Table 5.Y - TLBI Domain Hierarchy Level Table
+ */
+static void
+build_tlbh(GArray *table_data, BIOSLinker *linker, VirtMachineState *vms)
+{
+    int i;
+    uint32_t num_present_domains = 0;
+    AcpiTable table = { .sig = "TLBH", .rev = 1, .oem_id = vms->oem_id,
+                        .oem_table_id = vms->oem_table_id };
+
+    /* Count present domains first */
+    for (i = 0; i < vms->num_tlb_domains; i++) {
+        if (vms->tlbidomains[i].present) {
+            num_present_domains++;
+        }
+    }
+
+    acpi_table_begin(&table, table_data);
+
+    /* Number of mappings = number of present domains */
+    build_append_int_noprefix(table_data, num_present_domains, 4);
+
+    /* Mapping list offset (after header = 44) */
+    build_append_int_noprefix(table_data, 44, 4);
+
+    /* Mapping list - create sub-table for each present domain */
+    for (i = 0; i < vms->num_tlb_domains; i++) {
+        TlbDomainInfo *dom = &vms->tlbidomains[i];
+
+        if (!dom->present) {
+            continue;
+        }
+
+        /* TLBI Domain */
+        build_append_int_noprefix(table_data, dom->domain_id, 4);
+
+        /* Hierarchy Level (0=Root, 7=Leaf, default 7) */
+        build_append_int_noprefix(table_data, dom->level, 4);
+    }
+
+    acpi_table_end(linker, &table);
+}
+
