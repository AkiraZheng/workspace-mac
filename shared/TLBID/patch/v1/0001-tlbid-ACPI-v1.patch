new file mode 100644
index 0000000000..1a19c6d6b4
--- /dev/null
+++ b/hw/arm/tlbidomain.c
@@ -0,0 +1,180 @@
+/*
+ * TLBID domain configuration parsing
+ *
+ * Copyright (c) 2026
+ *
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms and conditions of the GNU General Public License,
+ * version 2 or later, as published by the Free Software Foundation.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/option.h"
+#include "qemu/cutils.h"
+#include "qemu/error-report.h"
+#include "qemu/config-file.h"
+#include "hw/arm/virt.h"
+#include "hw/arm/tlbidomain.h"
+#include "system/numa.h"
+
+QemuOptsList qemu_tlbidomain_opts = {
+    .name = "tlbidomain",
+    .implied_opt_name = "domain_id",
+    .head = QTAILQ_HEAD_INITIALIZER(qemu_tlbidomain_opts.head),
+    .desc = {
+        { /* end of list */ }
+    },
+};
+
+static int parse_tlbidomain_domain_id(const char *token, uint32_t *domain_id)
+{
+    unsigned long val;
+    if (qemu_strtou64(token, NULL, 10, &val) < 0) {
+        error_report("Invalid domain_id: %s", token);
+        return -1;
+    }
+    *domain_id = (uint32_t)val;
+    return 0;
+}
+
+static int parse_tlbidomain_cpu_range(const char *token, uint32_t *start, uint32_t *end)
+{
+    /* Expected format: 0-15 or 0_15 */
+    const char *range = token;
+    char *endptr;
+
+    /* Parse start CPU */
+    *start = strtoul(range, &endptr, 10);
+    if (endptr == range || (*endptr != '-' && *endptr != '_')) {
+        error_report("Invalid cpu range format: %s (expected 0-15)", token);
+        return -1;
+    }
+
+    /* Parse end CPU */
+    range = endptr + 1;
+    *end = strtoul(range, &endptr, 10);
+    if (*endptr != '\0') {
+        error_report("Invalid cpu range format: %s (expected 0-15)", token);
+        return -1;
+    }
+
+    if (*start > *end) {
+        error_report("Invalid cpu range: start (%u) > end (%u)", *start, *end);
+        return -1;
+    }
+
+    return 0;
+}
+
+static int parse_tlbidomain_level(const char *token, uint8_t *level)
+{
+    /* Expected format: level=7 */
+    if (strncmp(token, "level=", 6) != 0) {
+        return 0; /* Not a level parameter, not an error */
+    }
+
+    const char *value = token + 6;
+    unsigned long val = strtoul(value, NULL, 10);
+    if (val > 7) {
+        error_report("Invalid level: %lu (must be 0-7)", val);
+        return -1;
+    }
+    *level = (uint8_t)val;
+    return 1; /* Found level parameter */
+}
+
+static int parse_tlbidomain(void *opaque, QemuOpts *opts, Error **errp)
+{
+    VirtMachineState *vms = opaque;
+    MachineState *ms = MACHINE(vms);
+    const char *domain_id_str, *cpu_range_str, *level_str;
+    TlbDomainInfo *dom;
+    uint32_t domain_id, cpu_start, cpu_end;
+    uint8_t level = 7; /* Default Leaf */
+
+    if (vms->num_tlb_domains >= MAX_TLB_DOMAINS) {
+        error_setg(errp, "Too many tlbidomain configurations (max %d)", MAX_TLB_DOMAINS);
+        return -1;
+    }
+
+    domain_id_str = qemu_opt_get(opts, "domain_id");
+    if (!domain_id_str) {
+        error_setg(errp, "tlbidomain: missing domain_id");
+        return -1;
+    }
+
+    cpu_range_str = qemu_opt_get(opts, "cpus");
+    if (!cpu_range_str) {
+        error_setg(errp, "tlbidomain: missing cpu range");
+        return -1;
+    }
+
+    level_str = qemu_opt_get(opts, "level");
+
+    /* Parse domain_id */
+    if (parse_tlbidomain_domain_id(domain_id_str, &domain_id) < 0) {
+        error_setg(errp, "tlbidomain: invalid domain_id: %s", domain_id_str);
+        return -1;
+    }
+
+    /* Parse CPU range */
+    if (parse_tlbidomain_cpu_range(cpu_range_str, &cpu_start, &cpu_end) < 0) {
+        error_setg(errp, "tlbidomain: invalid cpu range: %s", cpu_range_str);
+        return -1;
+    }
+
+    /* Parse level (optional) */
+    if (level_str) {
+        if (parse_tlbidomain_level(level_str, &level) < 0) {
+            error_setg(errp, "tlbidomain: invalid level: %s", level_str);
+            return -1;
+        }
+    }
+
+    /* Validate CPU range */
+    if (cpu_end >= ms->smp.max_cpus) {
+        error_setg(errp, "tlbidomain: cpu end (%u) >= max_cpus (%d)",
+                   cpu_end, ms->smp.max_cpus);
+        return -1;
+    }
+
+    /* Check for duplicate domain_id */
+    for (int i = 0; i < vms->num_tlb_domains; i++) {
+        if (vms->tlbidomains[i].domain_id == domain_id) {
+            error_setg(errp, "tlbidomain: duplicate domain_id %u", domain_id);
+            return -1;
+        }
+    }
+
+    /* Store configuration */
+    dom = &vms->tlbidomains[vms->num_tlb_domains];
+    dom->domain_id = domain_id;
+    dom->cpu_start = cpu_start;
+    dom->cpu_end = cpu_end;
+    dom->level = level;
+    dom->present = true;
+    vms->num_tlb_domains++;
+
+    return 0;
+}
+
+static void tlbidomain_complete_init(VirtMachineState *vms)
+{
+    int i;
+
+    /* Check domain_id is consecutive starting from 0 */
+    for (i = 0; i < vms->num_tlb_domains; i++) {
+        TlbDomainInfo *dom = &vms->tlbidomains[i];
+        if (dom->domain_id != i) {
+            error_report("tlbidomain: domain_id must be consecutive starting from 0, "
+                         "but got %u at position %d", dom->domain_id, i);
+            exit(1);
+        }
+    }
+}
+
+void parse_tlbidomain_opts(MachineState *ms, VirtMachineState *vms)
+{
+    qemu_opts_foreach(qemu_find_opts("tlbidomain"), parse_tlbidomain, vms, &error_fatal);
+    tlbidomain_complete_init(vms);
+}
