From 36afe89202a8e488ac19d5449a2478d288b92ec2 Mon Sep 17 00:00:00 2001
From: AkiraZheng <1428384878@qq.com>
Date: Tue, 14 Apr 2026 23:28:05 +0000
Subject: [PATCH] arm64: Add trace_printk for page table attribute debugging in
 IOMMU path

Add trace_printk in the actual IOMMU/SMMU attribute configuration path
to debug MLX5 MMIO performance issues in VM passthrough scenarios:

1. drivers/vfio/vfio_iommu_type1.c: Trace vfio_iommu_map() - shows iova, pfn,
   npage, prot and IOMMU_CACHE flag before calling iommu_map()

2. drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c: Trace arm_smmu_map_pages() -
   shows iova (GPA), paddr (HPA), pgsize, pgcount, prot

3. drivers/iommu/io-pgtable-arm.c: Trace arm_lpae_prot_to_pte() - shows final
   PTE value with MemAttr string (NORMAL_OIWB, DEV_nGnRE, NORMAL_FWB, NC)

4. drivers/infiniband/hw/mlx5/main.c: Trace uar_mmap() - shows cmd, idx, pgprot

This trace captures the complete attribute configuration path:
  VFIO -> IOMMU -> SMMU -> io-pgtable (MemAttr)

View trace with:
  cat /sys/kernel/debug/tracing/trace | grep -E "vfio_iommu_map|arm_smmu_map_pages|arm_lpae_prot_to_pte|mlx5_uar_mmap"

Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>
---
 drivers/infiniband/hw/mlx5/main.c           |  8 ++++++++
 drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c |  5 +++++
 drivers/iommu/io-pgtable-arm.c              | 10 ++++++++++
 drivers/vfio/vfio_iommu_type1.c             |  5 +++++
 4 files changed, 28 insertions(+)

diff --git a/drivers/infiniband/hw/mlx5/main.c b/drivers/infiniband/hw/mlx5/main.c
index 0adb98b8dacc..07fa79900cf9 100644
--- a/drivers/infiniband/hw/mlx5/main.c
+++ b/drivers/infiniband/hw/mlx5/main.c
@@ -17,6 +17,7 @@
 #include <linux/sched/mm.h>
 #include <linux/sched/task.h>
 #include <linux/delay.h>
+#include <linux/trace.h>
 #include <rdma/ib_user_verbs.h>
 #include <rdma/ib_addr.h>
 #include <rdma/ib_cache.h>
@@ -2224,6 +2225,10 @@ static int uar_mmap(struct mlx5_ib_dev *dev, enum mlx5_ib_mmap_cmd cmd,
 		return -EINVAL;
 	}
 
+	/* Trace mmap attribute settings for debugging performance issues */
+	trace_printk("mlx5_uar_mmap: cmd=%d idx=%lu pgprot=0x%llx\n",
+		     cmd, idx, (unsigned long long)pgprot_val(prot));
+
 	if (dyn_uar) {
 		int uars_per_page;
 
@@ -2345,6 +2350,9 @@ static int mlx5_ib_mmap(struct ib_ucontext *ibcontext, struct vm_area_struct *vm
 	phys_addr_t pfn;
 
 	command = get_command(vma->vm_pgoff);
+	/* Trace mmap command routing for debugging */
+	trace_printk("mlx5_ib_mmap: command=%lu vm_pgoff=0x%lx\n", command, vma->vm_pgoff);
+
 	switch (command) {
 	case MLX5_IB_MMAP_WC_PAGE:
 	case MLX5_IB_MMAP_ALLOC_WC:
diff --git a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
index d355fa013e88..19f94da5d61e 100644
--- a/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
+++ b/drivers/iommu/arm/arm-smmu-v3/arm-smmu-v3.c
@@ -29,6 +29,7 @@
 #include <linux/platform_device.h>
 #include <kunit/visibility.h>
 #include <uapi/linux/iommufd.h>
+#include <linux/trace.h>
 
 #include "arm-smmu-v3.h"
 #include "../../dma-iommu.h"
@@ -3490,6 +3491,10 @@ static int arm_smmu_map_pages(struct iommu_domain *domain, unsigned long iova,
 	if (!ops)
 		return -ENODEV;
 
+	/* Trace SMMU map for debugging stage-2 attribute settings */
+	trace_printk("arm_smmu_map_pages: iova=0x%lx paddr=0x%llx pgsize=%zu pgcount=%zu prot=0x%x\n",
+		     iova, (unsigned long long)paddr, pgsize, pgcount, prot);
+
 	return ops->map_pages(ops, iova, paddr, pgsize, pgcount, prot, gfp, mapped);
 }
 
diff --git a/drivers/iommu/io-pgtable-arm.c b/drivers/iommu/io-pgtable-arm.c
index aecd5939e7b2..ec4153bd28f0 100644
--- a/drivers/iommu/io-pgtable-arm.c
+++ b/drivers/iommu/io-pgtable-arm.c
@@ -17,6 +17,7 @@
 #include <linux/slab.h>
 #include <linux/types.h>
 #include <linux/dma-mapping.h>
+#include <linux/trace.h>
 
 #include <asm/barrier.h>
 
@@ -540,6 +541,15 @@ static arm_lpae_iopte arm_lpae_prot_to_pte(struct arm_lpae_io_pgtable *data,
 	if (data->iop.fmt != ARM_MALI_LPAE)
 		pte |= ARM_LPAE_PTE_AF;
 
+	/* Trace final PTE value and MemAttr for stage-2 debugging */
+	trace_printk("arm_lpae_prot_to_pte: fmt=%d prot=0x%x pte=0x%llx memattr=%s\n",
+		     data->iop.fmt, prot, (unsigned long long)pte,
+		     (data->iop.fmt == ARM_64_LPAE_S2 || data->iop.fmt == ARM_32_LPAE_S2) ?
+		     ((pte >> 2) & 0xf) == 0xf ? "NORMAL_OIWB" :
+		     ((pte >> 2) & 0xf) == 0x1 ? "DEV_nGnRE" :
+		     ((pte >> 2) & 0xf) == 0x6 ? "NORMAL_FWB" :
+		     ((pte >> 2) & 0xf) == 0x5 ? "NC" : "OTHER" : "S1");
+
 	return pte;
 }
 
diff --git a/drivers/vfio/vfio_iommu_type1.c b/drivers/vfio/vfio_iommu_type1.c
index 1856c69f6551..dc8ab3e8bf6e 100644
--- a/drivers/vfio/vfio_iommu_type1.c
+++ b/drivers/vfio/vfio_iommu_type1.c
@@ -37,6 +37,7 @@
 #include <linux/vfio.h>
 #include <linux/workqueue.h>
 #include <linux/notifier.h>
+#include <linux/trace.h>
 #include "vfio.h"
 #ifdef CONFIG_HISI_VIRTCCA_CODA
 #include <linux/kvm_host.h>
@@ -1790,6 +1791,10 @@ static int vfio_iommu_map(struct vfio_iommu *iommu, dma_addr_t iova,
 		if (ret)
 			goto unwind;
 
+		/* Trace VFIO IOMMU map for debugging attribute settings */
+		trace_printk("vfio_iommu_map: iova=0x%llx pfn=0x%lx npage=%ld prot=0x%x IOMMU_CACHE=0x%x\n",
+			     (unsigned long long)iova, pfn, npage, prot, IOMMU_CACHE);
+
 		cond_resched();
 	}
 
-- 
