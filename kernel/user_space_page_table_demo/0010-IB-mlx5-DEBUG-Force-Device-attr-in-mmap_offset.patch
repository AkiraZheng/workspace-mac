From 1c9bd98489df58878803142229412f2a96b3ac2b Mon Sep 17 00:00:00 2001
From: AkiraZheng <1428384878@qq.com>
Date: Wed, 15 Apr 2026 05:32:55 +0000
Subject: [PATCH] IB/mlx5: DEBUG: Also force Device attr in mmap_offset path
 (cmd=8/9)

---
 drivers/infiniband/hw/mlx5/main.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/infiniband/hw/mlx5/main.c b/drivers/infiniband/hw/mlx5/main.c
index 58c4c6664f3e..9af948f9a2be 100644
--- a/drivers/infiniband/hw/mlx5/main.c
+++ b/drivers/infiniband/hw/mlx5/main.c
@@ -2347,8 +2347,10 @@ static int mlx5_ib_mmap_offset(struct mlx5_ib_dev *dev,
 		pr_info("mlx5_ib_mmap_offset: setting prot=pgprot_noncached\n");
 		prot = pgprot_noncached(vma->vm_page_prot);
 	} else {
-		pr_info("mlx5_ib_mmap_offset: setting prot=pgprot_writecombine\n");
-		prot = pgprot_writecombine(vma->vm_page_prot);
+		/* DEBUG: Force Device attribute to verify performance issue */
+		pr_info("mlx5_ib_mmap_offset: setting prot=pgprot_noncached (FORCE DEVICE)\n");
+		prot = pgprot_noncached(vma->vm_page_prot);
+		/* prot = pgprot_writecombine(vma->vm_page_prot); */
 	}
 	ret = rdma_user_mmap_io(ucontext, vma, pfn,
 				entry->npages * PAGE_SIZE,
-- 
