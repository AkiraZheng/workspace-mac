Author: AkiraZheng <1428384878@qq.com>
Date:   Wed Apr 15 02:49:52 2026 +0000

    IB/mlx5: DEBUG: Force Device attribute for UAR to verify performance issue
    
    DEBUG patch: Force all UAR mappings (WC/REGULAR) to use Device
    attribute (pgprot_noncached) instead of NORMAL_NC (pgprot_writecombine).
    
    This is to verify whether the page table attribute difference between
    Host and Guest is causing the performance regression in RDMA RoCE.
    
    DO NOT MERGE: This is a debug-only patch.
    
    View trace with:
      cat /sys/kernel/debug/tracing/trace | grep mlx5_uar_mmap
    
    Co-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>

diff --git a/drivers/infiniband/hw/mlx5/main.c b/drivers/infiniband/hw/mlx5/main.c
index 07fa79900cf9..fff725db2c29 100644
--- a/drivers/infiniband/hw/mlx5/main.c
+++ b/drivers/infiniband/hw/mlx5/main.c
@@ -2211,20 +2211,35 @@ static int uar_mmap(struct mlx5_ib_dev *dev, enum mlx5_ib_mmap_cmd cmd,
 		return -EINVAL;
 	}
 
+	/* DEBUG: print dmesg for uar_mmap */
+	pr_info("uar_mmap: cmd=%d idx=%lu dyn_uar=%d\n", cmd, idx, dyn_uar);
+
 	switch (cmd) {
 	case MLX5_IB_MMAP_WC_PAGE:
+		pr_info("uar_mmap: cmd=MLX5_IB_MMAP_WC_PAGE, setting prot\n");
+		prot = pgprot_writecombine(vma->vm_page_prot);
+		break;
 	case MLX5_IB_MMAP_ALLOC_WC:
+		pr_info("uar_mmap: cmd=MLX5_IB_MMAP_ALLOC_WC, setting prot\n");
+		prot = pgprot_writecombine(vma->vm_page_prot);
+		break;
 	case MLX5_IB_MMAP_REGULAR_PAGE:
 		/* For MLX5_IB_MMAP_REGULAR_PAGE do the best effort to get WC */
-		prot = pgprot_writecombine(vma->vm_page_prot);
+		/* DEBUG: Force Device attribute to verify performance issue */
+		pr_info("uar_mmap: cmd=MLX5_IB_MMAP_REGULAR_PAGE, setting prot=pgprot_noncached (FORCE DEVICE)\n");
+		prot = pgprot_noncached(vma->vm_page_prot);
+		/* prot = pgprot_writecombine(vma->vm_page_prot); */
 		break;
 	case MLX5_IB_MMAP_NC_PAGE:
+		pr_info("uar_mmap: cmd=MLX5_IB_MMAP_NC_PAGE, setting prot=pgprot_noncached\n");
 		prot = pgprot_noncached(vma->vm_page_prot);
 		break;
 	default:
 		return -EINVAL;
 	}
 
+	pr_info("uar_mmap: final prot=0x%llx\n", (unsigned long long)pgprot_val(prot));
+
 	/* Trace mmap attribute settings for debugging performance issues */
 	trace_printk("mlx5_uar_mmap: cmd=%d idx=%lu pgprot=0x%llx\n",
 		     cmd, idx, (unsigned long long)pgprot_val(prot));
@@ -2350,17 +2365,23 @@ static int mlx5_ib_mmap(struct ib_ucontext *ibcontext, struct vm_area_struct *vm
 	phys_addr_t pfn;
 
 	command = get_command(vma->vm_pgoff);
-	/* Trace mmap command routing for debugging */
-	trace_printk("mlx5_ib_mmap: command=%lu vm_pgoff=0x%lx\n", command, vma->vm_pgoff);
+	/* DEBUG: print dmesg for mmap command routing */
+	pr_info("mlx5_ib_mmap: command=%lu vm_pgoff=0x%lx entering switch\n", command, vma->vm_pgoff);
 
 	switch (command) {
 	case MLX5_IB_MMAP_WC_PAGE:
-	case MLX5_IB_MMAP_ALLOC_WC:
+		pr_info("mlx5_ib_mmap: command=MLX5_IB_MMAP_WC_PAGE, dev->wc_support=%d\n", dev->wc_support);
 		if (!dev->wc_support)
 			return -EPERM;
 		fallthrough;
+	case MLX5_IB_MMAP_ALLOC_WC:
+		pr_info("mlx5_ib_mmap: command=MLX5_IB_MMAP_ALLOC_WC\n");
+		fallthrough;
 	case MLX5_IB_MMAP_NC_PAGE:
+		pr_info("mlx5_ib_mmap: command=MLX5_IB_MMAP_NC_PAGE\n");
+		fallthrough;
 	case MLX5_IB_MMAP_REGULAR_PAGE:
+		pr_info("mlx5_ib_mmap: command=MLX5_IB_MMAP_REGULAR_PAGE, calling uar_mmap\n");
 		return uar_mmap(dev, command, vma, context);
 
 	case MLX5_IB_MMAP_GET_CONTIGUOUS_PAGES:
